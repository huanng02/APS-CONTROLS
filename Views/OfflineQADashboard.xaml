<Window x:Class="QuanLyGiuXe.Views.OfflineQADashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyGiuXe.Views"
        xmlns:converters="clr-namespace:QuanLyGiuXe.Converters"
        mc:Ignorable="d"
        Title="🚀 BẢNG ĐIỀU KHIỂN QA GIÁM SÁT NGOẠI TUYẾN &amp; ĐA KHU VỰC" Height="820" Width="1280"
        Background="#12121E" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        
        <!-- Premium dark scrollbar and visual overrides -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A1A28"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#222235"/>
                                <Setter Property="Foreground" Value="#3498DB"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#181825"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252538"/>
            <Setter Property="Foreground" Value="#8F94FB"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1D1D30" CornerRadius="10" Padding="20,15" Margin="0,0,0,15" BorderBrush="#2F2F4A" BorderThickness="1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="BẢNG GIÁM SÁT NGOẠI TUYẾN &amp; ĐA KHU VỰC ĐỒNG BỘ" Foreground="White" FontSize="22" FontWeight="ExtraBold"/>
                    <TextBlock Text="Giai đoạn 8.1 - Kiến trúc doanh nghiệp đa khu vực, Xác thực chuyển vùng &amp; Đảm bảo toàn vẹn" Foreground="#8F94FB" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#26FFFFFF" CornerRadius="15" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Conn.IsOnline, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='TRUE:#2ECC71|FALSE:#E74C3C'}"/>
                            <TextBlock Text="{Binding Conn.StatusText}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CONTROL PANEL (RESILIENCY AND LOGS) -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- System State controls -->
                <Border Grid.Row="0" Background="#1D1D30" CornerRadius="10" Padding="15" BorderBrush="#2F2F4A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CHUYỂN VÙNG LỖI &amp; KHẨN CẤP" Foreground="#FF5722" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                        <Button Command="{Binding ForceOfflineCommand}" Content="⚡ NGẮT KẾT NỐI BẮT BUỘC (NGOẠI TUYẾN)" Background="#E74C3C" Margin="0,0,0,8" Height="36"/>
                        <Button Command="{Binding ForceOnlineCommand}" Content="🔌 KHÔI PHỤC KẾT NỐI (TRỰC TUYẾN)" Background="#2ECC71" Margin="0,0,0,12" Height="36"/>

                        <TextBlock Text="ĐIỀU KHIỂN PHỤC HỒI" Foreground="#3498DB" FontWeight="Bold" FontSize="13" Margin="0,5,0,8"/>
                        <Button Command="{Binding ForceAutoRepairCommand}" Content="🔧 TỰ ĐỘNG SỬA PHIÊN QUÉT" Background="#8E44AD" Margin="0,0,0,8" Height="36"/>
                        <Button Command="{Binding TestWriteQueueCommand}" Content="📝 GHI GIAO DỊCH THỬ NGHIỆM" Background="#D35400" Margin="0,0,0,8" Height="36"/>
                        <Button Command="{Binding StressTestCommand}" Content="💥 KIỂM TRA ĐỘ BỀN TẢI HÀNG ĐỢI" Background="#7F8C8D" Margin="0,0,0,0" Height="36"/>
                    </StackPanel>
                </Border>

                <!-- Live Test Logging panel -->
                <Border Grid.Row="1" Background="#1D1D30" CornerRadius="10" Padding="15" Margin="0,15,0,0" BorderBrush="#2F2F4A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LỊCH SỬ KIỂM THỬ TÍCH HỢP" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="1" Text="{Binding TestLog}" Background="#0B0B14" Foreground="#2ECC71" 
                                 BorderThickness="1" BorderBrush="#1F1F35" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT TABBED WORKSPACE -->
            <TabControl Grid.Column="1" Background="#1D1D30" BorderThickness="1" BorderBrush="#2F2F4A">
                
                <!-- TAB 1: TELEMETRY & OFFLINE ENGINE -->
                <TabItem Header="🛰️  ĐO LƯỜNG ĐỘ BỀN HỆ THỐNG">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Telemetry Cards -->
                        <UniformGrid Rows="1" Columns="4" Grid.Row="0" Margin="0,0,0,15">
                            <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#2ECC71" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PHƯƠNG TIỆN TRONG BÃI" Foreground="#AAA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TelemetryLiveVehicleCount}" Foreground="#2ECC71" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#3498DB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PHIÊN ĐANG HOẠT ĐỘNG" Foreground="#AAA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TelemetryActiveSessions}" Foreground="#3498DB" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#E74C3C" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PHIÊN BỊ LỖI" Foreground="#AAA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TelemetrySuspiciousSessions}" Foreground="#E74C3C" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,0,0" BorderBrush="#F1C40F" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="KÍCH THƯỚC HÀNG ĐỢI CỤC BỘ" Foreground="#AAA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TelemetryPendingOfflineSync}" Foreground="#F1C40F" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Offline Queue Grid -->
                        <Border Grid.Row="1" Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="HÀNG ĐỢI GIAO DỊCH NGOẠI TUYẾN CỤC BỘ (SQLite)" Foreground="#8F94FB" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Transactions.Count, StringFormat='({0} items)'}" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời gian (UTC)" Binding="{Binding CreatedUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                                        <DataGridTextColumn Header="Loại" Binding="{Binding TransactionType}" Width="150"/>
                                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusColor}" CornerRadius="3" Padding="6,2">
                                                        <TextBlock Text="{Binding SyncStatus}" Foreground="White" FontSize="10" HorizontalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Số lần thử" Binding="{Binding RetryCount}" Width="70"/>
                                        <DataGridTextColumn Header="Lỗi / Lý do" Binding="{Binding ErrorMessage}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Session Consistency Audit logs -->
                        <Border Grid.Row="2" Background="#161626" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="NHẬT KÝ KIỂM TOÁN TÍNH ĐỒNG NHẤT PHIÊN TRỰC TIẾP" Foreground="#3498DB" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời gian (UTC)" Binding="{Binding CreatedUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                                        <DataGridTextColumn Header="Mã phiên / Số thẻ" Binding="{Binding SessionId}" Width="150"/>
                                        <DataGridTextColumn Header="Mã sự kiện" Binding="{Binding EventType}" Width="120"/>
                                        <DataGridTextColumn Header="Cũ" Binding="{Binding OldState}" Width="80"/>
                                        <DataGridTextColumn Header="Mới" Binding="{Binding NewState}" Width="80"/>
                                        <DataGridTextColumn Header="Kết quả / Chi tiết kiểm toán" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: PARKING TOPOLOGY CONFIG -->
                <TabItem Header="📐  CẤU HÌNH SƠ ĐỒ BÃI XE">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top-Left: Sites Panel -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="1. CÁC ĐIỂM ĐỖ XE" Foreground="#8F94FB" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Sites}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="40"/>
                                        <DataGridTextColumn Header="Mã điểm đỗ" Binding="{Binding SiteCode}" Width="100"/>
                                        <DataGridTextColumn Header="Tên điểm đỗ" Binding="{Binding SiteName}" Width="130"/>
                                        <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTemplateColumn Header="Thao tác" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" Content="Xóa" Background="#E74C3C" Padding="6,2" FontSize="10"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                     <TextBox Text="{Binding NewSiteCode, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Mã điểm đỗ"/>
                                     <TextBox Text="{Binding NewSiteName, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Tên điểm đỗ"/>
                                     <TextBox Text="{Binding NewSiteDesc, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Mô tả"/>
                                     <Button Command="{Binding SaveSiteCommand}" Content="Thêm" Grid.Column="3" Height="26" Padding="5,0" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Top-Right: Zones Panel -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="2. CÁC KHU VỰC ĐỖ (SỨC CHỨA)" Foreground="#8F94FB" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Zones}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Điểm đỗ" Binding="{Binding SiteId}" Width="40"/>
                                        <DataGridTextColumn Header="Mã khu vực" Binding="{Binding ZoneCode}" Width="100"/>
                                        <DataGridTextColumn Header="Tên khu vực" Binding="{Binding ZoneName}" Width="130"/>
                                        <DataGridTextColumn Header="Sức chứa tối đa" Binding="{Binding MaxCapacity}" Width="70"/>
                                        <DataGridTemplateColumn Header="Thao tác" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" Content="Xóa" Background="#E74C3C" Padding="6,2" FontSize="10"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                     <ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedZoneSite}" DisplayMemberPath="SiteCode" Grid.Column="0" Margin="0,0,4,0" Background="#222" Height="26" ToolTip="Chọn điểm đỗ"/>
                                     <TextBox Text="{Binding NewZoneCode, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Mã khu vực"/>
                                     <TextBox Text="{Binding NewZoneName, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Tên khu vực"/>
                                     <TextBox Text="{Binding NewZoneCapacity, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Sức chứa"/>
                                     <TextBox Text="{Binding NewZoneDesc, UpdateSourceTrigger=PropertyChanged}" Grid.Column="4" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Mô tả"/>
                                     <Button Command="{Binding SaveZoneCommand}" Content="Thêm" Grid.Column="5" Height="26" Padding="5,0" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Bottom-Left: Lanes Assignment -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#161626" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="3. LÀN XE &amp; CỔNG VẬT LÝ" Foreground="#8F94FB" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Lanes}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã làn" Binding="{Binding LaneCode}" Width="100"/>
                                        <DataGridTextColumn Header="Tên làn" Binding="{Binding LaneName}" Width="110"/>
                                        <DataGridTextColumn Header="Hướng" Binding="{Binding Direction}" Width="50"/>
                                        <DataGridTextColumn Header="Khu vực logic" Binding="{Binding ZoneName}" Width="*"/>
                                        <DataGridTextColumn Header="Cổng vật lý" Binding="{Binding GateName}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                     <ComboBox ItemsSource="{Binding Lanes}" SelectedItem="{Binding SelectedLane}" DisplayMemberPath="LaneName" Grid.Column="0" Margin="0,0,4,0" Background="#222" Height="26" ToolTip="Chọn Làn"/>
                                     <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedLaneZone}" DisplayMemberPath="ZoneName" Grid.Column="1" Margin="0,0,4,0" Background="#222" Height="26" ToolTip="Chọn khu vực logic (để trống nếu hỗn hợp)"/>
                                     <ComboBox ItemsSource="{Binding Gates}" SelectedItem="{Binding SelectedLaneGate}" DisplayMemberPath="GateName" Grid.Column="2" Margin="0,0,4,0" Background="#222" Height="26" ToolTip="Chọn Physical Gate"/>
                                     <Button Command="{Binding AssignLaneCommand}" Content="Gán làn" Grid.Column="3" Height="26" Padding="5,0" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Bottom-Right: C3 Controller configs -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#161626" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="4. PHÂN BỔ BỘ ĐIỀU KHIỂN C3" Foreground="#8F94FB" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Controllers}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên bộ điều khiển" Binding="{Binding ControllerName}" Width="120"/>
                                        <DataGridTextColumn Header="Địa chỉ IP" Binding="{Binding IpAddress}" Width="110"/>
                                        <DataGridTextColumn Header="IP Máy chủ" Binding="{Binding ServerIp}" Width="110"/>
                                        <DataGridTextColumn Header="IP Máy tính" Binding="{Binding PcIp}" Width="110"/>
                                        <DataGridTextColumn Header="Cổng được gán" Binding="{Binding GateName}" Width="*"/>
                                        <DataGridTemplateColumn Header="Thao tác" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteControllerCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" Content="Xóa" Background="#E74C3C" Padding="6,2" FontSize="10"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                     <TextBox Text="{Binding NewControllerName, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Tên Controller"/>
                                     <TextBox Text="{Binding NewControllerIp, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Tủ IP"/>
                                     <TextBox Text="{Binding NewControllerServerIp, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="IP Máy chủ"/>
                                     <TextBox Text="{Binding NewControllerPcIp, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="0,0,4,0" Background="#222" Foreground="White" BorderThickness="1" BorderBrush="#444" VerticalContentAlignment="Center" Height="26" ToolTip="Máy PC IP"/>
                                     <ComboBox ItemsSource="{Binding Gates}" SelectedItem="{Binding SelectedControllerGate}" DisplayMemberPath="GateName" Grid.Column="4" Margin="0,0,4,0" Background="#222" Height="26" ToolTip="Chọn Cổng"/>
                                     <Button Command="{Binding SaveControllerCommand}" Content="Thêm" Grid.Column="5" Height="26" Padding="5,0" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: RESILIENCY & MULTI-ZONE INTEGRATION QA -->
                <TabItem Header="🏆  BỘ KIỂM THỬ QA TỰ ĐỘNG ĐA KHU VỰC">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Automated Test Controller Header -->
                        <Border Grid.Row="0" Background="#161626" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#8E44AD" BorderThickness="1">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="HỆ THỐNG XÁC NHẬN ĐỘ BỀN TÍCH HỢP" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Nhấn nút chính dưới đây sẽ tự động chạy toàn bộ 5 kịch bản lỗi chuyển vùng phức tạp, ánh xạ động và khôi phục SQLite ngoại tuyến tuần tự." Foreground="#AAA" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button Command="{Binding RunAllTestsCommand}" Content="🚀 CHẠY TOÀN BỘ BỘ KIỂM THỬ TÍCH HỢP QA" Background="#8E44AD" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="25,12" FontSize="13" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Cards detailing the 5 Scenarios -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <UniformGrid Columns="2" Rows="3">
                                    
                                    <!-- Scenario 1 Card -->
                                    <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,10,10" BorderBrush="#2F2F4A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="KỊCH BẢN KIỂM THỬ 1: Khởi tạo Điểm &amp; Khu vực" Foreground="#F39C12" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                                <TextBlock Text="Xác minh tạo sơ đồ quan hệ, thiết lập cấu hình mặc định VINHOME/B1/B2 và thiết lập sức chứa tối đa." TextWrapping="Wrap" Foreground="#AAA" FontSize="11"/>
                                            </StackPanel>
                                            <Button Command="{Binding RunTest1Command}" Content="Chạy T1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Background="#34495E" Padding="12,8" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <!-- Scenario 2 Card -->
                                    <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#2F2F4A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="KỊCH BẢN KIỂM THỬ 2: Gán Làn &amp; Bộ điều khiển" Foreground="#F39C12" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                                <TextBlock Text="Ánh xạ các làn kiểm soát vật lý (LANE-1, LANE-2) và bộ điều khiển C3-200 trực tiếp tới khu vực logic." TextWrapping="Wrap" Foreground="#AAA" FontSize="11"/>
                                            </StackPanel>
                                            <Button Command="{Binding RunTest2Command}" Content="Chạy T2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Background="#34495E" Padding="12,8" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <!-- Scenario 3 Card -->
                                    <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,10,10" BorderBrush="#2F2F4A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="KỊCH BẢN KIỂM THỬ 3: Tính toán Phiên quét động" Foreground="#F39C12" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                                <TextBlock Text="Thực hiện mô phỏng quẹt thẻ vào và xác nhận rằng số lượng xe được tính toán động từ các phiên đang hoạt động." TextWrapping="Wrap" Foreground="#AAA" FontSize="11"/>
                                            </StackPanel>
                                            <Button Command="{Binding RunTest3Command}" Content="Chạy T3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Background="#34495E" Padding="12,8" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <!-- Scenario 4 Card -->
                                    <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#2F2F4A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="KỊCH BẢN KIỂM THỬ 4: Giới hạn Sức chứa Khu vực" Foreground="#F39C12" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                                <TextBlock Text="Lấp đầy khu vực tới giới hạn sức chứa, xác nhận cảnh báo 'Khu vực đầy' và tự động chặn thẻ quẹt sau đó." TextWrapping="Wrap" Foreground="#AAA" FontSize="11"/>
                                            </StackPanel>
                                            <Button Command="{Binding RunTest4Command}" Content="Chạy T4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Background="#34495E" Padding="12,8" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <!-- Scenario 5 Card -->
                                    <Border Background="#161626" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#2F2F4A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="KỊCH BẢN KIỂM THỬ 5: Đồng bộ khi mất kết nối" Foreground="#F39C12" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                                <TextBlock Text="Giả lập mất kết nối SQL, quẹt thẻ để ghi giao dịch vào hàng đợi SQLite, kết nối lại SQL và xác minh tự động đồng bộ phiên hoạt động." TextWrapping="Wrap" Foreground="#AAA" FontSize="11"/>
                                            </StackPanel>
                                            <Button Command="{Binding RunTest5Command}" Content="Chạy T5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Background="#34495E" Padding="12,8" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <!-- Help & Info Card -->
                                    <Border Background="#1A1A28" CornerRadius="8" Padding="15" Margin="0,0,0,0" BorderBrush="#2F2F4A" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="💡 THÔNG TIN TUÂN THỦ HỆ THỐNG PHỤC HỒI" Foreground="#3498DB" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Text="Tất cả các bản cập nhật DB đã được xác minh tự phục hồi. Nhật ký WAL ngăn chặn khóa. Đồng bộ hóa sử dụng đường dẫn dự phòng bộ nhớ SQLite an toàn." TextWrapping="Wrap" Foreground="#888" FontSize="10"/>
                                        </StackPanel>
                                    </Border>

                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                
            </TabControl>
        </Grid>

        <!-- FOOTER -->
        <TextBlock Grid.Row="2" Text="Bảng giám sát Ngoại tuyến &amp; Sơ đồ bãi xe • Phát triển bởi Antigravity Recovery Engine V2" Foreground="#4E4E6A" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="10" FontWeight="Bold"/>
    </Grid>
</Window>
