<Window x:Class="QuanLyGiuXe.Views.DeploymentChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chi Tiết Thay Đổi Phiên Bản" 
        Height="550" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TopoPageBgBrush}"
        FontFamily="Segoe UI, Inter, Arial"
        ResizeMode="NoResize"
        BorderThickness="1"
        BorderBrush="#2C3E50">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Info summary -->
            <RowDefinition Height="*"/>    <!-- Changes list -->
            <RowDefinition Height="Auto"/> <!-- Footer / Close button -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" 
                      Fill="{StaticResource TopoPrimaryBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtTitle" Text="CHI TIẾT THAY ĐỔI PHIÊN BẢN" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Danh sách các thuộc tính cấu hình đã được thay đổi trong phiên bản này." FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- 2. Info Summary -->
        <Border Grid.Row="1" Background="#1A2835" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Người triển khai: " FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                        <TextBlock x:Name="txtDeployer" Text="Admin" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                        <TextBlock Text="   |   Thời gian: " FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                        <TextBlock x:Name="txtDeployTime" Text="03/06/2026 11:00" FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ghi chú: " FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}" VerticalAlignment="Top"/>
                        <TextBlock x:Name="txtNotes" Text="Không có ghi chú" FontSize="12" Foreground="{StaticResource TopoTextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="450" VerticalAlignment="Top"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" x:Name="brdStatus" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" Text="SUCCESS" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- 3. List of Changes -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Các thay đổi chi tiết:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}" Margin="0,0,0,8"/>

            <!-- List box for audit items -->
            <ListBox Grid.Row="1" x:Name="lstChanges" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1C2E3F" CornerRadius="6" Padding="12,10" BorderThickness="1,0,0,0" BorderBrush="{StaticResource TopoPrimaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="#2C3E50" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding EntityType}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding EntityName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding PropertyName}" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text=": " FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding OldValue}" FontSize="11" Foreground="#FF9E9E" TextDecorations="Strikethrough"/>
                                        <TextBlock Text=" → " FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding NewValue}" FontSize="11" Foreground="{StaticResource TopoSuccessBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Time / User of the change -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding UserName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="10" Foreground="{StaticResource TopoTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state illustration -->
            <TextBlock x:Name="txtEmptyState" Grid.Row="1" Text="Không có thay đổi cấu hình nào được ghi nhận." FontSize="13" Foreground="{StaticResource TopoTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- 4. Footer -->
        <Button Grid.Row="3" Content="Đóng" Width="100" Height="36" HorizontalAlignment="Right" Style="{StaticResource TopoActionButton}" Background="#2C3E50" Click="Close_Click"/>
    </Grid>
</Window>
