<Window x:Class="QuanLyGiuXe.Views.LichSuXeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:QuanLyGiuXe.Converters"
        Title="Chi tiết lượt xe"
        Height="780"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgLightBrush}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Scrollable content -->
            <RowDefinition Height="Auto"/> <!-- Close Button -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="CHI TIẾT LƯỢT XE" FontSize="16" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,12" HorizontalAlignment="Center"/>

        <!-- Scrollable Photos and Text Details -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
                <!-- License Plate Display (Digital glowing dark badge) -->
                <Border BorderBrush="#1E293B" BorderThickness="1" Background="#0F172A" CornerRadius="8" Padding="18,6" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedLichSu.BienSo}" FontSize="28" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                </Border>

                <!-- ENTRY & EXIT IMAGES SIDE-BY-SIDE -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- LƯỢT XE VÀO / ENTRY -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
                        <StackPanel>
                            <TextBlock Text="📷 XE VÀO" FontWeight="Bold" FontSize="11" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                            
                            <!-- Overview Image -->
                            <TextBlock Text="Toàn cảnh / Overview" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#F1F5F9" Height="140" Margin="0,0,0,6">
                                <Grid>
                                    <Image Source="{Binding SelectedAnhVaoToanCanh}" Stretch="Uniform" Margin="1"/>
                                    <Border Background="#F1F5F9" CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAnhVaoToanCanh}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAnhVaoToanCanh}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xEBA9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Không có ảnh" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Plate Cam Image -->
                            <TextBlock Text="Ảnh biển số / Plate Cam" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#F1F5F9" Height="140" Margin="0,0,0,6">
                                <Grid>
                                    <Image Source="{Binding SelectedAnhVaoBienSo}" Stretch="Uniform" Margin="1"/>
                                    <Border Background="#F1F5F9" CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAnhVaoBienSo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAnhVaoBienSo}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xEBA9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Không có ảnh" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Cropped Plate -->
                            <TextBlock Text="Biển số cắt / Cropped" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White" CornerRadius="4" Padding="2" Height="45" HorizontalAlignment="Center" Width="140">
                                <Grid>
                                    <Image Source="{Binding SelectedAnhVaoBienSoCat}" Stretch="Uniform" Margin="1"/>
                                    <Border Background="White" CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAnhVaoBienSoCat}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAnhVaoBienSoCat}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="CHƯA CẮT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- LƯỢT XE RA / EXIT -->
                    <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="8" Padding="8">
                        <StackPanel>
                            <TextBlock Text="📷 XE RA" FontWeight="Bold" FontSize="11" Foreground="{StaticResource APSRedBrush}" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                            
                            <!-- Overview Image -->
                            <TextBlock Text="Toàn cảnh / Overview" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                            <Border BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="6" Background="#F1F5F9" Height="140" Margin="0,0,0,6">
                                <Grid>
                                    <Image Source="{Binding SelectedAnhRaToanCanh}" Stretch="Uniform" Margin="1"/>
                                    <Border Background="#F1F5F9" CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAnhRaToanCanh}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAnhRaToanCanh}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xEBA9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Không có ảnh" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Plate Cam Image -->
                            <TextBlock Text="Ảnh biển số / Plate Cam" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                            <Border BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="6" Background="#F1F5F9" Height="140" Margin="0,0,0,6">
                                <Grid>
                                    <Image Source="{Binding SelectedAnhRaBienSo}" Stretch="Uniform" Margin="1"/>
                                    <Border Background="#F1F5F9" CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAnhRaBienSo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAnhRaBienSo}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xEBA9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Không có ảnh" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Cropped Plate -->
                            <TextBlock Text="Biển số cắt / Cropped" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                            <Border BorderBrush="#FCA5A5" BorderThickness="1" Background="White" CornerRadius="4" Padding="2" Height="45" HorizontalAlignment="Center" Width="140">
                                <Grid>
                                    <Image Source="{Binding SelectedAnhRaBienSoCat}" Stretch="Uniform" Margin="1"/>
                                    <Border Background="White" CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAnhRaBienSoCat}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAnhRaBienSoCat}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="CHƯA CẮT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DETAILS PROPERTY SHEET -->
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Employee details -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Ticket Type -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại vé / Ticket:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedLichSu.LoaiVeName, TargetNullValue='Vé lượt'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}" Margin="0,4,0,4"/>

                        <!-- Row 1: Vehicle Type -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Loại xe / Vehicle:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedLichSu.LoaiXeName, TargetNullValue='-'}" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,4"/>

                        <!-- Row 2: Status -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Trạng thái / Status:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedLichSu.TrangThai, TargetNullValue='-'}" FontSize="12.5" FontWeight="Bold" Margin="0,4,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLichSu.TrangThai}" Value="Đã ra">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedLichSu.TrangThai}" Value="Trong bãi">
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Row 3: Card ID -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Mã thẻ / Card ID:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedLichSu.CardId}" FontSize="12.5" Margin="0,4,0,4"/>

                        <!-- Row 4: In Time -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Giờ vào / In Time:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedLichSu.ThoiGianVao, StringFormat='dd/MM/yyyy HH:mm:ss'}" FontSize="12.5" Margin="0,4,0,4"/>

                        <!-- Row 5: In Lane -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Làn vào / In Lane:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedLichSu.EntryLaneName}" FontSize="12.5" Margin="0,4,0,4"/>

                        <!-- Row 6: Out Time -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Giờ ra / Out Time:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedLichSu.ThoiGianRa, StringFormat='dd/MM/yyyy HH:mm:ss', TargetNullValue='Chưa ra'}" FontSize="12.5" Margin="0,4,0,4"/>

                        <!-- Row 7: Out Lane -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Làn ra / Out Lane:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedLichSu.ExitLaneName, TargetNullValue='-'}" FontSize="12.5" Margin="0,4,0,4"/>

                        <!-- Row 8: Site -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Khu vực / Site:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedLichSu.SiteName, TargetNullValue='-'}" FontSize="12.5" Margin="0,4,0,4"/>

                        <!-- Row 9: Zone -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Vùng / Zone:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedLichSu.ZoneName, TargetNullValue='-'}" FontSize="12.5" Margin="0,4,0,4"/>

                        <!-- Row 10: Parking Duration -->
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Thời gian đỗ:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ThoiGianDo}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E65100" Margin="0,4,0,4"/>

                        <!-- Row 11: Chủ thẻ -->
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Chủ thẻ:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"
                                   Visibility="{Binding SelectedLichSu.EmployeeName, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedLichSu.EmployeeName}" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,4"
                                   Visibility="{Binding SelectedLichSu.EmployeeName, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Row 12: Mã NV -->
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Mã nhân viên:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"
                                   Visibility="{Binding SelectedLichSu.EmployeeCode, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedLichSu.EmployeeCode}" FontSize="12.5" Margin="0,4,0,4"
                                   Visibility="{Binding SelectedLichSu.EmployeeCode, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Row 13: Công ty -->
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Công ty:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"
                                   Visibility="{Binding SelectedLichSu.CompanyName, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding SelectedLichSu.CompanyName}" FontSize="12.5" Margin="0,4,0,4"
                                   Visibility="{Binding SelectedLichSu.CompanyName, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Row 14: Phòng ban -->
                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Phòng ban:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,10,4"
                                   Visibility="{Binding SelectedLichSu.DepartmentName, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding SelectedLichSu.DepartmentName}" FontSize="12.5" Margin="0,4,0,4"
                                   Visibility="{Binding SelectedLichSu.DepartmentName, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                
                <!-- REVENUE PAYMENT DISPLAY (Premium green badge) -->
                <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="TIỀN THANH TOÁN:" FontSize="11" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedLichSu.Tien, StringFormat={}{0:N0} VNĐ, TargetNullValue='0'}" FontSize="18" FontWeight="Bold" Foreground="#1B5E20" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ACTION BUTTONS FOR ACTIVE SESSION (Xe trong bãi) -->
                <Button Command="{Binding EndSessionCommand}"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        Height="38"
                        Margin="0,0,0,12"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedLichSu.TrangThai}" Value="Trong bãi">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kết thúc phiên ngay" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="2" Content="ĐÓNG" Style="{StaticResource ModernOutlineButton}" Height="40" Click="Close_Click"/>
    </Grid>
</Window>
