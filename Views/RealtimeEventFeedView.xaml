<UserControl x:Class="QuanLyGiuXe.Views.RealtimeEventFeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyGiuXe.Views"
             xmlns:viewmodels="clr-namespace:QuanLyGiuXe.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BgLightBrush}" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Custom Scrollbar Template for SOC Feed -->
        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                    Grid.Column="0" Grid.Row="0" 
                                                    Content="{TemplateBinding Content}" 
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       Grid.Column="1" Grid.Row="0" 
                                       Value="{TemplateBinding VerticalOffset}" 
                                       Maximum="{TemplateBinding ScrollableHeight}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                                       Width="8" Margin="2,0,2,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Top SOC Metrics Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Filter & Action Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Timeline Stream -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================= 1. SOC LIVE METRICS ======================= -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Events Card -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="White" CornerRadius="8" Padding="12" BorderThickness="0,0,0,4" BorderBrush="{StaticResource APSBlueBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TỔNG SỰ KIỆN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🔔" FontSize="28" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Info Card -->
            <Border Grid.Column="1" Margin="0,0,10,0" Background="White" CornerRadius="8" Padding="12" BorderThickness="0,0,0,4" BorderBrush="#3498DB">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding InfoCount}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🔵" FontSize="24" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Success Card -->
            <Border Grid.Column="2" Margin="0,0,10,0" Background="White" CornerRadius="8" Padding="12" BorderThickness="0,0,0,4" BorderBrush="#2ECC71">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="THÀNH CÔNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SuccessCount}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🟢" FontSize="24" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Warning Card -->
            <Border Grid.Column="3" Margin="0,0,10,0" Background="White" CornerRadius="8" Padding="12" BorderThickness="0,0,0,4" BorderBrush="#F1C40F">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CẢNH BÁO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WarningCount}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🟡" FontSize="24" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Error Card -->
            <Border Grid.Column="4" Margin="0,0,10,0" Background="White" CornerRadius="8" Padding="12" BorderThickness="0,0,0,4" BorderBrush="#E67E22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LỖI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ErrorCount}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🟠" FontSize="24" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Critical Card -->
            <Border Grid.Column="5" Margin="0,0,0,0" Background="White" CornerRadius="8" Padding="12" BorderThickness="0,0,0,4" BorderBrush="#E74C3C">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NGHIÊM TRỌNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CriticalCount}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🔴" FontSize="24" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= 2. FILTER & CONTROLS ======================= -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Segment Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Bộ lọc:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="5,0,15,0"/>
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding}" 
                                             GroupName="EventFilters"
                                             Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding}"
                                             Margin="0,0,6,0" Padding="12,5"
                                             Cursor="Hand">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F2F4F8"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource APSBlueBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource APSBlueBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Actions (Pause, Clear, Auto-scroll) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pause/Resume Toggle -->
                    <ToggleButton IsChecked="{Binding IsPaused}" Margin="0,0,8,0" Padding="12,6" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Content" Value="⏸ Tạm dừng"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#FDEDEC"/>
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                        <Setter Property="Content" Value="▶ Tiếp tục"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Auto Scroll Checkbox -->
                    <CheckBox IsChecked="{Binding AutoScroll}" Content="Tự cuộn" VerticalAlignment="Center" Margin="5,0,15,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- Clear Log Button -->
                    <Button Command="{Binding ClearCommand}" Content="🗑 Xóa hết" Style="{StaticResource ModernOutlineButton}" Height="30" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= 3. TIMELINE EVENT FEED ======================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15,20,15,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <!-- Dotted Axis Line in the background -->
                <Line X1="45" Y1="0" X2="45" Y2="{Binding ElementName=ScrollFeed, Path=ActualHeight}" 
                      Stroke="#CED4DA" StrokeThickness="1.5" StrokeDashArray="4 4" 
                      VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                <!-- Scrollable Timeline Items -->
                <ScrollViewer x:Name="ScrollFeed" 
                              Style="{StaticResource ModernScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    
                    <ItemsControl ItemsSource="{Binding DisplayEvents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <!-- Column for the Timeline Circle Point -->
                                        <ColumnDefinition Width="90"/>
                                        <!-- Column for the Event Card -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timeline Node Circle -->
                                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                                        <Border Width="30" Height="30" 
                                                Background="{Binding SeverityBackgroundBrush}" 
                                                BorderBrush="{Binding SeverityBrush}" 
                                                BorderThickness="1.5" 
                                                CornerRadius="15">
                                            <TextBlock Text="{Binding EventIcon}" 
                                                       FontSize="13" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Translucent Glassmorphism Card -->
                                    <Border Grid.Column="1" 
                                            Background="#FAFCFF" 
                                            BorderBrush="{StaticResource BorderLightBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="15,12,15,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F4F8FD"/>
                                                        <Setter Property="BorderBrush" Value="{Binding SeverityBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Card Header: Time, Severity and Scope Tags -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left info: Timestamp & Severity Label -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🕒" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding FormattedTimestamp}" 
                                                               Foreground="{StaticResource APSBlueBrush}" 
                                                               FontWeight="Bold" 
                                                               FontSize="12" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,12,0"/>
                                                    
                                                    <Border Background="{Binding SeverityBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Severity}" 
                                                                   Foreground="{Binding SeverityBrush}" 
                                                                   FontWeight="ExtraBold" 
                                                                   FontSize="9"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Right info: Site / Zone scope tags -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#EBF5FB" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding Site}" Foreground="#2980B9" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#FEF9E7" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Zone}" Foreground="#D35400" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Middle: Event title and Description -->
                                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                                <TextBlock Text="{Binding EventType}" 
                                                           Foreground="{Binding SeverityBrush}" 
                                                           FontWeight="ExtraBold" 
                                                           FontSize="13"/>
                                                
                                                <TextBlock Text="{Binding Message}" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                                           FontSize="12.5" 
                                                           TextWrapping="Wrap" 
                                                           Margin="0,4,0,0"
                                                           LineHeight="18"/>
                                            </StackPanel>

                                            <!-- Bottom Bar: Gate, Lane and Source system -->
                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Dynamic Lane & Gate placement -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Cổng:" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                    <TextBlock Text="{Binding Gate}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="4,0,15,0"/>
                                                    
                                                    <TextBlock Text="Làn:" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                    <TextBlock Text="{Binding Lane}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10.5" Margin="4,0,0,0"/>
                                                </StackPanel>

                                                <!-- Source identification -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="Nguồn: " Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                    <Border Background="#F2F4F8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9.5" FontFamily="Consolas"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
