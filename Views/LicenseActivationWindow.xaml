<Window x:Class="QuanLyGiuXe.Views.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích hoạt Bản quyền - C3 Parking System" 
        Height="320" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#252830"/>
            <Setter Property="BorderBrush" Value="#383C4A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                Background="{TemplateBinding Background}" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="border" Property="Background" Value="#1E222A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderThickness="1" BorderBrush="#2A2E3D" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#16181E" Offset="0"/>
                <GradientStop Color="#0D0E12" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="C3 PARKING SYSTEM" FontSize="11" FontWeight="Bold" Foreground="#00D2FF"/>
                    <TextBlock Text="Kích Hoạt Bản Quyền Ngoại Tuyến" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="✕" FontSize="16" Foreground="#8A8F9E" Padding="8" Click="Close_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,12">
                <!-- Fingerprint Field -->
                <TextBlock Text="MÃ PHẦN CỨNG THIẾT BỊ (MACHINE ID)" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FingerprintBox" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Background="#1D2026" Foreground="#8A8F9E" BorderBrush="#2A2E3D"/>
                    <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="Sao chép" Padding="12,8" Margin="8,0,0,0" Click="Copy_Click">
                        <Button.Background>
                            <SolidColorBrush Color="#2F3342"/>
                        </Button.Background>
                    </Button>
                </Grid>

                <!-- Offline Activation Section -->
                <TextBlock Text="KÍCH HOẠT OFFLINE (BẰNG TẬP TIN)" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Content="Xuất yêu cầu kích hoạt (.req)" Padding="12,10" Margin="0,0,6,0" Click="ExportRequest_Click">
                        <Button.Background>
                            <SolidColorBrush Color="#2F3342"/>
                        </Button.Background>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="Nhập tập tin bản quyền (.bin)" Padding="12,10" Margin="6,0,0,0" Click="ImportLicense_Click">
                        <Button.Background>
                            <SolidColorBrush Color="#2F3342"/>
                        </Button.Background>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Footer & Actions -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <!-- Status/Error message -->
                <TextBlock x:Name="StatusBlock" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#FF6565"/>
            </Grid>
        </Grid>
    </Border>
</Window>
