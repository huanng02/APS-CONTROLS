<Window x:Class="QuanLyGiuXe.Views.DepartmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department Information" 
        Height="340" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource APSBlueBrush}" CornerRadius="4" Padding="8" Margin="0,0,12,0">
                    <TextBlock Text="📁" Foreground="White" FontSize="14"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="DEPARTMENT DETAILS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                    <TextBlock Text="Create department under a specific company" Style="{StaticResource SubTitleStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form fields -->
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Belongs to Company *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="cbCompany" Style="{StaticResource ModernComboBox}" Height="32" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Department Name *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="txtDepartmentName" Style="{StaticResource ModernTextBox}" Height="32"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Status *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="cbStatus" Style="{StaticResource ModernComboBox}" Height="32">
                    <ComboBoxItem Content="Active" IsSelected="True"/>
                    <ComboBoxItem Content="Inactive"/>
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Footer Actions -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ModernOutlineButton}" Width="90" Margin="0,0,10,0" Height="34"/>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource ModernButton}" Width="90" Height="32"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
