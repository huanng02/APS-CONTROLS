<UserControl x:Class="QuanLyGiuXe.Views.TopologyValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyGiuXe.Views"
             xmlns:viewmodels="clr-namespace:QuanLyGiuXe.ViewModels"
             xmlns:converters="clr-namespace:QuanLyGiuXe.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Background="{StaticResource TopoPageBgBrush}"
             FontFamily="Segoe UI, Inter, Arial">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Inverse Boolean to Visibility Converter for when we want to hide stuff when loading -->
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        
        <!-- Value converters or styles for issues -->
        <Style x:Key="IssueCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TopoCardBgBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.04" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Stats/Summary -->
            <RowDefinition Height="*"/>    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- HEADER PANEL                                                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" 
                          Fill="{StaticResource TopoPrimaryBrush}" 
                          Width="28" Height="28" 
                          Stretch="Uniform" 
                          Margin="0,0,12,0"/>
                    <TextBlock Text="TRUNG TÂM KIỂM TRA SƠ ĐỒ" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TopoTextPrimaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Kiểm tra liên tục tính hợp lệ logic và trạng thái sẵn sàng vận hành của sơ đồ bãi xe."
                           FontSize="13" 
                           Foreground="{StaticResource TopoTextSecondaryBrush}" 
                           Margin="40,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Command="{Binding RefreshCommand}" 
                    Style="{StaticResource TopoActionButton}" 
                    Background="{StaticResource TopoPrimaryBrush}"
                    Padding="16,10"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Refresh chevron path -->
                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                          Fill="White" 
                          Width="14" Height="14" 
                          Stretch="Uniform" 
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Kiểm tra hệ thống" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STATISTICS CARDS                                            -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ERRORS CARD -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0" BorderBrush="{StaticResource TopoDangerBrush}" BorderThickness="0,3,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource StatNumberStyle}" Foreground="{StaticResource TopoDangerBrush}"/>
                        <TextBlock Text="Lỗi" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                    <Path Grid.Column="1" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h-2v-2h6v2h-2v2zm0-6h-2V7h2v4z" 
                          Fill="{StaticResource TopoDangerBrush}" Width="32" Height="32" Stretch="Uniform" Opacity="0.15" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- WARNINGS CARD -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0" BorderBrush="{StaticResource TopoWarningBrush}" BorderThickness="0,3,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding WarningCount}" Style="{StaticResource StatNumberStyle}" Foreground="{StaticResource TopoWarningBrush}"/>
                        <TextBlock Text="Cảnh báo" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                    <Path Grid.Column="1" Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" 
                          Fill="{StaticResource TopoWarningBrush}" Width="32" Height="32" Stretch="Uniform" Opacity="0.15" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- INFO CARD -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0" BorderBrush="{StaticResource TopoPrimaryBrush}" BorderThickness="0,3,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding InfoCount}" Style="{StaticResource StatNumberStyle}" Foreground="{StaticResource TopoPrimaryBrush}"/>
                        <TextBlock Text="Thông tin" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                    <Path Grid.Column="1" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                          Fill="{StaticResource TopoPrimaryBrush}" Width="32" Height="32" Stretch="Uniform" Opacity="0.15" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- STATUS CARD -->
            <Border Grid.Column="3">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TopoSuccessBrush}"/>
                                <Setter Property="BorderThickness" Value="0,3,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter Property="BorderBrush" Value="{StaticResource TopoDangerBrush}"/>
                                <Setter Property="BorderThickness" Value="0,3,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ValidationStatusText}" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TopoSuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TopoDangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Trạng thái hệ thống" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>

                    <!-- Icon displaying depending on IsValid -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                              Fill="{StaticResource TopoSuccessBrush}" Width="32" Height="32" Stretch="Uniform"
                              Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"/>
                        <!-- Error cross path if invalid -->
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                              Fill="{StaticResource TopoDangerBrush}" Width="28" Height="28" Stretch="Uniform"
                              Visibility="{Binding IsValid, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- CONTENT AREA (ISSUES LIST OR SUCCESS SCREEN)                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- Scrollable issues view (Visible if not loading) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                
                <StackPanel Margin="0,0,10,0">
                    
                    <!-- SUCCESS CARD: Only shown when HasRun is true, and there are absolutely 0 issues -->
                    <Border Padding="40" Margin="0,0,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DetailCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasRun}" Value="True"/>
                                            <Condition Binding="{Binding ErrorCount}" Value="0"/>
                                            <Condition Binding="{Binding WarningCount}" Value="0"/>
                                            <Condition Binding="{Binding InfoCount}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Premium Green Shield checkmark -->
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" 
                                  Fill="{StaticResource TopoSuccessBrush}" 
                                  Width="80" Height="80" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  Margin="0,0,0,20"/>
                            <TextBlock Text="✓ Cấu hình topology hợp lệ" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TopoTextPrimaryBrush}" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Không phát hiện lỗi hoặc cảnh báo nào. Hệ thống sẵn sàng đưa vào vận hành." 
                                       FontSize="14" 
                                       Foreground="{StaticResource TopoTextSecondaryBrush}" 
                                       HorizontalAlignment="Center" 
                                       TextAlignment="Center"
                                       MaxWidth="500"/>
                        </StackPanel>
                    </Border>

                    <!-- ERRORS SECTION -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource TopoDangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="LỖI CẤU HÌNH" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TopoDangerBrush}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource TopoDangerBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ErrorCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ErrorIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IssueCardStyle}" BorderBrush="{StaticResource TopoDangerBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                                                  Fill="{StaticResource TopoDangerBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Đối tượng:  " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="Loại: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding TranslatedEntityType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                    <TextBlock Text="  •  Tên: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding EntityName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                    
                                                    <TextBlock Text="  •  Mức độ ảnh hưởng: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Impact}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoDangerBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- WARNINGS SECTION -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource TopoWarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="CẢNH BÁO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TopoWarningBrush}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource TopoWarningBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding WarningCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding WarningIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IssueCardStyle}" BorderBrush="{StaticResource TopoWarningBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Path Grid.Column="0" Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" 
                                                  Fill="{StaticResource TopoWarningBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Đối tượng:  " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="Loại: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding TranslatedEntityType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                    <TextBlock Text="  •  Tên: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding EntityName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                    
                                                    <TextBlock Text="  •  Mức độ ảnh hưởng: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Impact}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoWarningBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- INFORMATION SECTION -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InfoCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource TopoPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="THÔNG TIN" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TopoPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource TopoPrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding InfoCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding InfoIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IssueCardStyle}" BorderBrush="{StaticResource TopoPrimaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                                                  Fill="{StaticResource TopoPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Đối tượng:  " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="Loại: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding TranslatedEntityType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                    <TextBlock Text="  •  Tên: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding EntityName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                    
                                                    <TextBlock Text="  •  Mức độ ảnh hưởng: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Impact}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoPrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- LOADING SPINNER & OVERLAY (Visible if loading) -->
            <Border Background="#B0F5F7FA" 
                    CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200" Height="6" 
                                 Background="{StaticResource TopoPrimaryLightBrush}" 
                                 Foreground="{StaticResource TopoPrimaryBrush}" 
                                 Margin="0,0,0,15"/>
                    <TextBlock Text="Đang chạy trình kiểm tra tính hợp lệ của sơ đồ bãi xe..." 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TopoTextPrimaryBrush}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Đang phân tích các bộ điều khiển, làn xe, cổng và cấu hình ánh xạ..." 
                               FontSize="12" 
                               Foreground="{StaticResource TopoTextSecondaryBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
