<Window x:Class="QuanLyGiuXe.Views.CameraSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:QuanLyGiuXe.Converters"
        mc:Ignorable="d"
        Title="QUẢN LÝ THIẾT BỊ CAMERA" 
        Height="680" 
        Width="1050"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F4F6">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="3.5*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: CAMERA LIST & FILTERS -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search & Filters -->
            <Border Grid.Row="0" Style="{StaticResource EnterpriseCardBorder}" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search TextBox -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tìm kiếm camera" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" Height="32"/>
                    </StackPanel>

                    <!-- Filter ComboBox -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Trạng thái" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedValue="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModernComboBox}" Height="32"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid Title -->
            <TextBlock Grid.Row="1" Text="Danh sách Camera" FontSize="14" FontWeight="Bold" Foreground="#1F2937" Margin="5,0,0,8"/>

            <!-- Cameras DataGrid -->
            <Border Grid.Row="2" CornerRadius="8" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="CamerasGrid" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                          IsEnabled="{Binding IsFormEditable, Converter={StaticResource InverseBoolConverter}}"
                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="White"
                          RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                          SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <!-- Status Indicator Column -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Fill" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tên Camera" Binding="{Binding CameraName}" Width="*" FontSize="12" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Địa chỉ IP" Binding="{Binding IpAddress}" Width="110" FontSize="11"/>
                        <DataGridTextColumn Header="Làn đã gán" Binding="{Binding LaneName}" Width="100" FontSize="11"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bottom Left Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Button Content="➕ Thêm Mới" Command="{Binding AddNewCommand}" Style="{StaticResource ModernButton}" 
                        IsEnabled="{Binding IsFormEditable, Converter={StaticResource InverseBoolConverter}}"
                        Background="#2563EB" Foreground="White" Width="120" Height="36"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT PANEL: DETAIL / EDITOR CARD -->
        <Border Grid.Column="2" Style="{StaticResource EnterpriseCardBorder}" Background="White" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="#1E3A8A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                            <Setter Property="Text" Value="📹 THÊM CAMERA MỚI"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="⚙️ CẬP NHẬT CẤU HÌNH CAMERA"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCreateMode}" Value="False"/>
                                                <Condition Binding="{Binding IsEditMode}" Value="False"/>
                                                <Condition Binding="{Binding SelectedCamera, Converter={StaticResource NullToBoolConverter}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="🔎 CHI TIẾT CAMERA"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Separator Margin="0,8,0,0" Background="#E5E7EB"/>
                    </StackPanel>

                    <!-- ONVIF Discovery Button (only visible when form is editable) -->
                    <Button Grid.Column="1" Content="🔍 Tìm Cam ONVIF" Command="{Binding DiscoverCamerasCommand}" 
                            Style="{StaticResource ModernButton}" Background="#0D9488" Foreground="White" 
                            Width="120" Height="30" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Top"
                            Visibility="{Binding IsFormEditable, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Main Fields Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Show message if nothing is selected and not creating -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedCamera}" Value="{x:Null}"/>
                                                <Condition Binding="{Binding IsCreateMode}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📹" FontSize="48" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Vui lòng chọn một camera từ danh sách để xem chi tiết hoặc nhấn 'Thêm Mới'" 
                                       Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Fields Grid -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedCamera}" Value="{x:Null}"/>
                                                <Condition Binding="{Binding IsCreateMode}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Camera Name -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Tên Camera (*)" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                         IsEnabled="{Binding IsFormEditable}" Height="32"/>
                            </StackPanel>

                            <!-- Key & Protocol -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Key -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mã Camera / Key (*)" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CameraKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                             IsEnabled="{Binding IsCreateMode}" Height="32"/>
                                </StackPanel>

                                <!-- Protocol -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giao thức" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedValue="{Binding Protocol}"
                                              Style="{StaticResource ModernComboBox}" IsEnabled="{Binding IsFormEditable}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- IP Address & Port -->
                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- IP -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Địa chỉ IP (*)" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                             IsEnabled="{Binding IsFormEditable}" Height="32"/>
                                    <TextBlock Text="{Binding IpValidationMessage}" Foreground="#EF4444" FontSize="10" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasIpError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Port -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cổng (*)" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                             IsEnabled="{Binding IsFormEditable}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Username & Password -->
                            <Grid Grid.Row="3" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Username -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tên đăng nhập" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                             IsEnabled="{Binding IsFormEditable}" Height="32"/>
                                </StackPanel>

                                <!-- Password -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mật khẩu" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                             IsEnabled="{Binding IsFormEditable}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- RTSP URL -->
                            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                                <TextBlock Text="Đường dẫn RTSP (*)" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RtspUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                         IsEnabled="{Binding IsFormEditable}" Height="32"/>
                            </StackPanel>

                            <!-- Lane & Direction & Active Status -->
                            <Grid Grid.Row="5" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lane -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Gán cho Làn xe" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Lanes}" SelectedItem="{Binding SelectedLane}"
                                              DisplayMemberPath="LaneName" Style="{StaticResource ModernComboBox}" 
                                              IsEnabled="{Binding IsLaneSelectionEnabled}" Height="32"/>
                                </StackPanel>

                                <!-- Direction / Type -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Loại Camera" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedValue="{Binding Direction}"
                                              Style="{StaticResource ModernComboBox}" IsEnabled="{Binding IsFormEditable}" Height="32"/>
                                </StackPanel>

                                <!-- Active Status -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding IsActive}" Content="Kích hoạt" FontWeight="SemiBold" 
                                              IsEnabled="{Binding IsFormEditable}" Foreground="#374151"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Resolution -->
                            <Grid Grid.Row="6" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="3.5*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Độ phân giải" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedValue="{Binding ResolutionOption}"
                                              Style="{StaticResource ModernComboBox}" IsEnabled="{Binding IsFormEditable}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Test Connection -->
                            <Border Grid.Row="7" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button x:Name="BtnTestConnect" Grid.Column="0" Content="🔌 Kiểm tra kết nối" Click="BtnTestConnect_Click" 
                                             Style="{StaticResource ModernOutlineButton}" Height="32" Padding="15,0"/>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding TestConnectionResult}" FontWeight="SemiBold" 
                                               VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestConnectionColor}" Value="Green">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TestConnectionColor}" Value="Red">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TestConnectionColor}" Value="Orange">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TestConnectionColor}" Value="Gray">
                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- Actions Footer -->
                <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <Grid>
                        <!-- Edit / Delete mode buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFormEditable}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Content="⚙️ Sửa" Command="{Binding EditCommand}" Style="{StaticResource ModernButton}" 
                                    Background="#F59E0B" Foreground="White" Width="100" Height="36" Margin="0,0,10,0"/>
                            <Button Content="🗑️ Xóa" Command="{Binding DeleteCommand}" Style="{StaticResource ModernButton}" 
                                    Background="#EF4444" Foreground="White" Width="100" Height="36" Margin="0,0,10,0"/>
                            <Button Content="Đóng" Click="Close_Click" Style="{StaticResource ModernOutlineButton}" Width="100" Height="36"/>
                        </StackPanel>

                        <!-- Saving mode buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFormEditable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Content="💾 Lưu lại" Command="{Binding SaveCommand}" Style="{StaticResource ModernButton}" 
                                    Background="#10B981" Foreground="White" Width="120" Height="36" Margin="0,0,10,0"/>
                            <Button Content="Hủy bỏ" Command="{Binding CancelCommand}" Style="{StaticResource ModernOutlineButton}" Width="100" Height="36"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT PANEL: LIVE PREVIEW CARD -->
        <Border Grid.Column="4" Style="{StaticResource EnterpriseCardBorder}" Background="Black" ClipToBounds="True">
            <Grid>
                <!-- Live Video Feed Image -->
                <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Standby/Status Overlay -->
                <StackPanel x:Name="NoStreamOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📹 XEM TRỰC TIẾP" Foreground="#64748B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OverlaySubText" Text="Chọn camera hoặc nhấn 'Kiểm tra kết nối' để xem hình ảnh." Foreground="#475569" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
