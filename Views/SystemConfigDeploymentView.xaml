                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95C8.08 7.14 9.94 6 12 6c2.62 0 4.88 1.86 5.39 4.43l.3 1.5 1.53.11c1.56.1 2.78 1.41 2.78 2.96 0 1.65-1.35 3-3 3z" 
                                      Fill="{StaticResource TopoPrimaryBrush}" 
                                      Width="28" Height="28" 
                                      Stretch="Uniform" 
                                      Margin="0,0,12,0"/>
                                <TextBlock Text="TRUNG TÂM TRIỂN KHAI VÀ QUẢN TRỊ" 
                                           FontSize="20" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource TopoTextPrimaryBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Quản lý phiên bản cấu hình hệ thống, kiểm tra tính hợp lệ trước khi triển khai và xem lịch sử thay đổi."
                                       FontSize="13" 
                                       Foreground="{StaticResource TopoTextSecondaryBrush}" 
                                       Margin="40,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding RefreshCommand}" 
                                    Style="{StaticResource TopoActionButton}" 
                                    Background="#2A3F54"
                                    BorderBrush="#3E5A73"
                                    BorderThickness="1"
                                    Padding="16,10"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="White" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Làm mới" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- DASHBOARD GRID -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: STATUS & DEPLOY FORM -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                            <Grid Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Active Version Card -->
                                    <RowDefinition Height="Auto"/> <!-- Pending Changes Card -->
                                    <RowDefinition Height="Auto"/> <!-- Validation Card -->
                                    <RowDefinition Height="Auto"/> <!-- Deployment Action Card -->
                                </Grid.RowDefinitions>

                                <!-- 1. Active Version Card -->
                                <Border Grid.Row="0" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Padding="16,12" BorderBrush="{StaticResource TopoPrimaryBrush}" BorderThickness="0,3,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Phiên Bản Hiện Tại" Style="{StaticResource StatLabelStyle}" FontSize="12"/>
                                            <TextBlock Text="{Binding CurrentVersion}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}" Margin="0,4,0,4"/>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="Triển khai bởi: " FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding CurrentDeployUser}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                                <TextBlock Text="  •  " FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding CurrentDeployTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Icon badge -->
                                        <Border Grid.Column="1" Background="#1D2B3A" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                                                  Fill="{StaticResource TopoPrimaryBrush}" Width="28" Height="28" Stretch="Uniform"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 2. Pending Changes Card -->
                                <Border Grid.Row="1" Margin="0,0,0,12" Padding="16,12">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource TopoWarningBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,3,0,0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasPendingChanges}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#2A3F54"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Trạng Thái Thay Đổi" Style="{StaticResource StatLabelStyle}" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6" VerticalAlignment="Center">
                                                    <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" 
                                                          Fill="{StaticResource TopoWarningBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                                          Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                                                        <Setter Property="Text" Value="⚠ Có thay đổi cấu hình chưa triển khai"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TopoWarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasPendingChanges}" Value="False">
                                                                        <Setter Property="Text" Value="✓ Cấu hình đồng nhất với môi trường chạy"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TopoSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="#2A3F54" Margin="0,8,0,8"/>

                                        <UniformGrid Columns="4" Rows="2">
                                            <!-- Sites -->
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Site thay đổi" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PendingSitesCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Zones -->
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Zone thay đổi" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PendingZonesCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Gates -->
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Cổng thay đổi" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PendingGatesCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Lanes -->
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Làn thay đổi" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PendingLanesCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Readers -->
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Đầu đọc đổi" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PendingReadersCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Controllers -->
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Tủ điều khiển" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PendingControllersCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Cameras -->
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Camera đổi" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PendingCamerasCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Validation Summary Card -->
                                <Border Grid.Row="2" Margin="0,0,0,12" Padding="16,12">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource TopoSuccessBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,3,0,0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{StaticResource TopoDangerBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,3,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Trạng Thái Xác Thực Topology" Style="{StaticResource StatLabelStyle}" FontSize="12"/>
                                        <TextBlock Text="{Binding ValidationStatusText}" FontSize="15" FontWeight="Bold" Margin="0,4,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TopoSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource TopoDangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Background="#23171B" CornerRadius="4" Padding="8,6" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="Lỗi: " FontSize="12" Foreground="{StaticResource TopoDangerBrush}"/>
                                                    <TextBlock Text="{Binding ErrorCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TopoDangerBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Background="#262118" CornerRadius="4" Padding="8,6" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="Cảnh báo: " FontSize="12" Foreground="{StaticResource TopoWarningBrush}"/>
                                                    <TextBlock Text="{Binding WarningCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TopoWarningBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Background="#172223" CornerRadius="4" Padding="8,6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="Thông tin: " FontSize="12" Foreground="{StaticResource TopoPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding InfoCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TopoPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- List of Errors blocking deployment (if any) -->
                                        <StackPanel Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" Margin="0,10,0,0">
                                            <TextBlock Text="Các lỗi chặn triển khai:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoDangerBrush}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding ErrorIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Description, StringFormat='• {0}'}" FontSize="11" Foreground="#FF9E9E" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Deployment Action Card -->
                                <Border Grid.Row="3" Style="{StaticResource StatCardStyle}" Padding="16,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="Triển Khai Cấu Hình" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            <TextBlock Text="Lưu ý: Chỉ được phép triển khai khi hệ thống không có lỗi nghiêm trọng (Errors = 0) và có thay đổi cấu hình chưa triển khai." 
                                                       FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,4,0,12">
                                            <TextBlock Text="Ghi chú triển khai (Notes):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextWrapping="Wrap" 
                                                     AcceptsReturn="True" 
                                                     VerticalScrollBarVisibility="Auto"
                                                     Height="80"
                                                     Background="#1A2835"
                                                     Foreground="White"
                                                     BorderBrush="#2C3E50"
                                                     BorderThickness="1"
                                                     Padding="8"/>
                                        </StackPanel>

                                        <!-- Deploy Button -->
                                        <Button Grid.Row="2"
                                                Command="{Binding DeployCommand}"
                                                Background="{StaticResource TopoSuccessBrush}"
                                                Height="45"
                                                HorizontalAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TopoActionButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#2F3B2F"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" 
                                                      Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Triển Khai Cấu Hình Ngay (Deploy)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- RIGHT COLUMN: AUDIT TRAIL & HISTORY -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.2*"/> <!-- Recent Changes (Audit Trail) -->
                                <RowDefinition Height="1*"/>   <!-- Deployment History -->
                            </Grid.RowDefinitions>

                            <!-- 1. Recent Changes Card -->
                            <Border Grid.Row="0" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="Nhật Ký Thay Đổi Cấu Hình (Audit Trail)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                        <TextBlock Text="Tự động ghi nhận tất cả thay đổi chi tiết cấp độ thuộc tính (không có log thủ công)." FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding AuditHistory}" Style="{StaticResource CleanListBoxStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1C2E3F" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderThickness="1,0,0,0" BorderBrush="{StaticResource TopoPrimaryBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <Border Background="#2C3E50" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding EntityType}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding EntityName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                                            </StackPanel>
                                                            
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding PropertyName}" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}" FontWeight="SemiBold"/>
                                                                <TextBlock Text=": " FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding OldValue}" FontSize="11" Foreground="#FF9E9E" TextDecorations="Strikethrough"/>
                                                                <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="{StaticResource TopoTextSecondaryBrush}" Width="10" Height="10" Margin="6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" → " FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding NewValue}" FontSize="11" Foreground="{StaticResource TopoSuccessBrush}" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Metadata column -->
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding UserName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="10" Foreground="{StaticResource TopoTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- 2. Deployment History Card -->
                            <Border Grid.Row="1" Style="{StaticResource StatCardStyle}" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="Lịch Sử Triển Khai (Deployment History)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                        <TextBlock Text="Danh sách các phiên bản đã được kích hoạt hoặc thất bại." FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding DeploymentHistory}" Style="{StaticResource CleanListBoxStyle}" ItemContainerStyle="{StaticResource DeployHistoryItemStyle}" SelectedItem="{Binding SelectedDeployment, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderThickness="1,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1C2E3F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="SUCCESS">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TopoSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TopoDangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Background" Value="#253A4E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Version tag -->
                                                            <ColumnDefinition Width="*"/>    <!-- Notes / Deployment details -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Deploy user / status -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Version Tag -->
                                                        <Border Grid.Column="0" Background="#2C3E50" CornerRadius="4" Width="42" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Version, StringFormat='V{0}'}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Notes -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{StaticResource TopoTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DeployTime, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" FontSize="10" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Status / User -->
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="SUCCESS">
                                                                                <Setter Property="Background" Value="#1B3322"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                                                <Setter Property="Background" Value="#331B1B"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="SUCCESS">
                                                                                    <Setter Property="Foreground" Value="{StaticResource TopoSuccessBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                                                    <Setter Property="Foreground" Value="{StaticResource TopoDangerBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock Text="{Binding DeployBy, StringFormat='Triển khai: {0}'}" FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
