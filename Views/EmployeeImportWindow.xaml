<Window x:Class="QuanLyGiuXe.Views.EmployeeImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BULK EMPLOYEE IMPORT" Height="700" Width="1100" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgLightBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource EnterpriseCardBorder}" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnChoose" Content="📁 CHỌN FILE" Style="{StaticResource ModernOutlineButton}" Width="150" Margin="0,0,12,0" Click="BtnChoose_Click"/>
                <TextBox x:Name="TxtPath" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Width="350" VerticalAlignment="Center" Padding="10,8"/>
                
                <Border Width="1" Background="{StaticResource BorderLightBrush}" Margin="20,5"/>
                
                <Button x:Name="BtnPreview" Content="👁️ XEM TRƯỚC" Style="{StaticResource ModernButton}" Background="{StaticResource APSBlueBrush}" Width="130" Margin="0,0,10,0" Click="BtnPreview_Click"/>
                <Button x:Name="BtnImport" Content="🚀 NHẬP DỮ LIỆU" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" Width="150" Click="BtnImport_Click"/>
            </StackPanel>
        </Border>

        <!-- Preview Grid -->
        <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Padding="0">
            <DataGrid x:Name="PreviewGrid" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DÒNG" Binding="{Binding RowNumber}" Width="60"/>
                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="100"/>
                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding FullName}" Width="150"/>
                    <DataGridTextColumn Header="CÔNG TY" Binding="{Binding CompanyName}" Width="130"/>
                    <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding DepartmentName}" Width="120"/>
                    <DataGridTextColumn Header="CHỨC VỤ" Binding="{Binding PositionName}" Width="100"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="100"/>
                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="120"/>
                    <DataGridTextColumn Header="CCCD" Binding="{Binding CCCD}" Width="100"/>
                    <DataGridTextColumn Header="MÃ THẺ (CARDUID)" Binding="{Binding CardUID}" Width="120"/>
                    <DataGridTextColumn Header="BIỂN SỐ XE" Binding="{Binding BienSo}" Width="100"/>
                    <DataGridTextColumn Header="LOẠI XE" Binding="{Binding LoaiXe}" Width="90"/>
                    <DataGridTextColumn Header="LOẠI VÉ" Binding="{Binding LoaiVe}" Width="90"/>
                    <DataGridTextColumn Header="HẠN THẺ" Binding="{Binding NgayHetHan, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status & Progress -->
        <Border Grid.Row="2" Style="{StaticResource EnterpriseCardBorder}" Padding="15" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStats" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource APSBlueBrush}"/>
                <ProgressBar x:Name="ImportProgressBar" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Margin="30,0" Background="{StaticResource BgLightBrush}" Foreground="{StaticResource SuccessBrush}" BorderThickness="0"/>
                <TextBlock Grid.Column="2" Text="SẴN SÀNG" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
