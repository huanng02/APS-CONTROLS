<UserControl x:Class="QuanLyGiuXe.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource BgLightBrush}" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header + Filters (Fixed at top) -->
            <RowDefinition Height="*"/>    <!-- Scrollable Content under Filters -->
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Margin="10,0,10,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                <Border Background="{StaticResource APSBlueBrush}" CornerRadius="4" Padding="10" Margin="0,0,15,0">
                    <TextBlock Text="📊" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="DASHBOARD HỆ THỐNG" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSBlueBrush}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource BgLightBrush}" BorderBrush="{StaticResource APSBlueBrush}" BorderThickness="1" CornerRadius="15" Padding="12,5" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedDateRangeDisplay}" Foreground="{StaticResource APSBlueBrush}" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <ProgressBar IsIndeterminate="True" Width="80" Height="2" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource APSBlueBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Filters -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" 
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Topology Filters -->
                        <ColumnDefinition Width="*"/> <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Date Filters & Export -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Topology Filters -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏢 Bãi Xe:" Style="{StaticResource SubTitleStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="180" Style="{StaticResource ModernComboBox}" Margin="0,0,20,0"
                                  ItemsSource="{Binding Sites}" DisplayMemberPath="SiteName" SelectedItem="{Binding SelectedSite}"/>
                                  
                        <TextBlock Text="📍 Khu Vực:" Style="{StaticResource SubTitleStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="180" Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Zones}" DisplayMemberPath="ZoneName" SelectedItem="{Binding SelectedZone}"/>
                    </StackPanel>
                    
                    <!-- Date Filters & Export -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,20,0">
                            <TextBlock Text="Từ:" Style="{StaticResource SubTitleStyle}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker SelectedDate="{Binding FromDate}" Width="120" />
                            <TextBlock Text="Đến:" Style="{StaticResource SubTitleStyle}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <DatePicker SelectedDate="{Binding ToDate}" Width="120" />
                        </StackPanel>

                        <TextBlock Text="Thời gian:" Style="{StaticResource SubTitleStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Width="140" Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"/>

                        <Button Command="{Binding ExportCommand}" Margin="15,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" Padding="15,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" Margin="0,0,8,0"/>
                                <TextBlock x:Name="btnText" Text="Xuất Excel" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Scrollable Dashboard Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="10,15,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- KPI Cards Row -->
                    <RowDefinition Height="Auto"/> <!-- Collapsible Detailed Analytics -->
                    <RowDefinition Height="350"/>  <!-- Charts Row -->
                    <RowDefinition Height="300"/>  <!-- Bottom Row -->
                </Grid.RowDefinitions>

                <!-- KPI Cards Row -->
                <UniformGrid Grid.Row="0" Columns="4">
                    
                    <!-- Card 1 -->
                    <Border Style="{StaticResource EnterpriseCardBorder}" BorderBrush="{StaticResource APSBlueBrush}" BorderThickness="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TRẠNG THÁI BÃI XE" Style="{StaticResource SubTitleStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding XeTrongBai}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                    <TextBlock Text="/" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="2,0,2,4"/>
                                    <TextBlock Text="{Binding TongCho}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="🚗" FontSize="32" Opacity="0.3" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border Style="{StaticResource EnterpriseCardBorder}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LƯỢT XE RA VÀO" Style="{StaticResource SubTitleStyle}"/>
                                <TextBlock Text="{Binding LuotXeVao}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="📈" FontSize="32" Opacity="0.3" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Card 3 -->
                    <Border Style="{StaticResource EnterpriseCardBorder}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TỔNG DOANH THU" Style="{StaticResource SubTitleStyle}"/>
                                <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0} đ}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="💰" FontSize="32" Opacity="0.3" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Card 4 -->
                    <Border Style="{StaticResource EnterpriseCardBorder}" BorderBrush="{StaticResource APSBlueBrush}" BorderThickness="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VÉ ĐANG HOẠT ĐỘNG" Style="{StaticResource SubTitleStyle}"/>
                                <TextBlock Text="{Binding VeActive}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="💳" FontSize="32" Opacity="0.3" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Collapsible Detailed Analytics -->
                <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Margin="0,15,0,0" Padding="8" Background="White">
                    <Expander Header="Xem thống kê chi tiết theo loại vé &amp; loại xe / Detailed Analytics" IsExpanded="False" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Padding="4">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Ticket Type Breakdown -->
                            <Border Grid.Column="0" BorderBrush="#E3E6F0" BorderThickness="0,0,1,0" Margin="0,0,10,0" Padding="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="🎫 THỐNG KÊ THEO LOẠI VÉ / TICKET STATS" FontWeight="Bold" FontSize="10" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,6"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                        <ItemsControl ItemsSource="{Binding ThongKeLoaiVe}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8F9FC" BorderThickness="1" BorderBrush="#E3E6F0" CornerRadius="4" Padding="8,4" Margin="0,2,6,2" MinWidth="115">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TenLoaiVe}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                                            <Grid Margin="0,2,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Vào: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Grid.Column="0" Text="{Binding SoLuotVao}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Margin="22,0,0,0"/>
                                                                <TextBlock Grid.Column="2" Text="Ra: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding SoLuotRa}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="18,0,0,0"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0} đ}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Right: Vehicle Type Breakdown -->
                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🚗 THỐNG KÊ THEO LOẠI XE / VEHICLE STATS" FontWeight="Bold" FontSize="10" Foreground="#7C3AED" Margin="0,0,0,6"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                    <ItemsControl ItemsSource="{Binding ThongKeLoaiXe}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F5F3FF" BorderThickness="1" BorderBrush="#DDD6FE" CornerRadius="4" Padding="8,4" Margin="0,2,6,2" MinWidth="130">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TenLoaiXe}" FontWeight="Bold" Foreground="#5B21B6" FontSize="11"/>
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="Lượt: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding SoLuot}" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <TextBlock Text="Bãi: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding DangTrongBai}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0} đ}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Expander>
                </Border>

                <!-- Charts Row -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Revenue Chart -->
                    <Border Grid.Column="0" Style="{StaticResource EnterpriseCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="TỔNG QUAN DOANH THU" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,15"/>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding RevenueSeries}" Margin="0,10,0,0">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding RevenueLabels}" />
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis LabelFormatter="{Binding RevenueFormatter}" />
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <!-- Hourly Chart -->
                    <Border Grid.Column="1" Style="{StaticResource EnterpriseCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="TẦN SUẤT XE THEO GIỜ" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,15"/>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding HourlySeries}" Margin="0,10,0,0">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding HourlyLabels}" />
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis LabelFormatter="{Binding HourlyFormatter}" MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Row -->
                <Grid Grid.Row="3" Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Park Status -->
                    <Border Grid.Column="0" Style="{StaticResource EnterpriseCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="TRẠNG THÁI BÃI XE" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,15"/>
                            
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Sức chứa: " Style="{StaticResource SubTitleStyle}"/>
                                <TextBlock Text="{Binding TongCho}" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" Height="20" Value="{Binding TyLeLapDay, Mode=OneWay}" Maximum="100" 
                                         Foreground="{StaticResource APSBlueBrush}" Background="{StaticResource BgLightBrush}" BorderThickness="0" Margin="0,10"/>
                            
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Đã đỗ" Style="{StaticResource SubTitleStyle}"/>
                                    <TextBlock Text="{Binding XeTrongBai}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                    <TextBlock Text="{Binding TyLeLapDay, StringFormat={}{0:N1}%}" Style="{StaticResource SubTitleStyle}" Foreground="{StaticResource APSBlueBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Còn trống" Style="{StaticResource SubTitleStyle}"/>
                                    <TextBlock Text="{Binding ChoTrong}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Warning if Near Full -->
                            <Border Grid.Row="3" VerticalAlignment="Bottom" Background="#FFF1F0" BorderBrush="{StaticResource APSRedBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNearFull}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" Margin="0,0,10,0"/>
                                    <TextBlock Text="Bãi xe sắp đầy!" Foreground="{StaticResource APSRedBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Recent Activity -->
                    <Border Grid.Column="1" Style="{StaticResource EnterpriseCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="SỰ KIỆN GẦN ĐÂY" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,15"/>
                            
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RecentActivities}" Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="BIỂN SỐ" Binding="{Binding BienSo}" Width="150" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding ThoiGian, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150"/>
                                    
                                    <DataGridTemplateColumn Header="HÀNH ĐỘNG" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,2" CornerRadius="12" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HanhDong}" Value="VÀO">
                                                                    <Setter Property="Background" Value="#E6FFFA"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HanhDong}" Value="RA">
                                                                    <Setter Property="Background" Value="#FFF5F5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding HanhDong}" FontWeight="Bold" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HanhDong}" Value="VÀO">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HanhDong}" Value="RA">
                                                                        <Setter Property="Foreground" Value="{StaticResource APSRedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="LOẠI XE" Binding="{Binding TheLoai}" Width="120"/>
                                    <DataGridTextColumn Header="PHÍ BÃI XE" Binding="{Binding GiaTien, StringFormat={}{0:N0} đ}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

