<Window x:Class="QuanLyGiuXe.Views.ReasonInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yêu cầu lý do thao tác"
        Height="500"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}">

    <Grid Margin="12">

        <Border Style="{StaticResource EnterpriseCardBorder}" Padding="18">

            <Grid>

                <!-- 3 vùng chính -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="CẢNH BÁO AN NINH"
                               Style="{StaticResource Heading2Style}"
                               Foreground="{StaticResource APSRedBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Thao tác này có rủi ro cao (Mở cổng thủ công). Vui lòng nhập lý do để phục vụ kiểm toán hệ thống."
                               Style="{StaticResource SubTitleStyle}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- ================= CONTENT ================= -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- Quick reasons -->
                        <TextBlock Text="CHỌN NHANH LÝ DO"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>

                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="Khách đặc biệt"
                                    Click="QuickReason_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,5"
                                    Background="#E8EFF9"
                                    Foreground="{StaticResource APSBlueBrush}"
                                    BorderThickness="0"/>

                            <Button Content="Lỗi biển số"
                                    Click="QuickReason_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,5"
                                    Background="#E8EFF9"
                                    Foreground="{StaticResource APSBlueBrush}"
                                    BorderThickness="0"/>

                            <Button Content="Lỗi thẻ RFID "
                                    Click="QuickReason_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,5"
                                    Background="#E8EFF9"
                                    Foreground="{StaticResource APSBlueBrush}"
                                    BorderThickness="0"/>

                            <Button Content="Xe khẩn cấp / Cứu hỏa"
                                    Click="QuickReason_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,5"
                                    Background="#E8EFF9"
                                    Foreground="{StaticResource APSBlueBrush}"
                                    BorderThickness="0"/>
                        </WrapPanel>

                        <!-- Input -->
                        <TextBlock Text="NHẬP LÝ DO CHI TIẾT"
                                   FontWeight="Bold"
                                   Margin="0,6,0,6"/>

                        <TextBox x:Name="txtReason"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="45"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"/>

                        <TextBlock x:Name="txtError"
                                   Foreground="{StaticResource APSRedBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </ScrollViewer>

                <!-- ================= ACTION ================= -->
                <Border Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="HỦY BỎ"
                                Style="{StaticResource ModernOutlineButton}"
                                Width="110"
                                Height="38"
                                Margin="0,0,10,0"
                                Click="BtnCancel_Click"/>

                        <Button Content="XÁC NHẬN MỞ CỔNG"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource SuccessBrush}"
                                Width="190"
                                Height="38"
                                Click="BtnOk_Click"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>