<Window x:Class="QuanLyGiuXe.Views.ReasonInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yêu cầu lý do thao tác" Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BgLightBrush}">
    <Grid Margin="12">
        <Border Style="{StaticResource EnterpriseCardBorder}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CẢNH BÁO AN NINH" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSRedBrush}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Text="Đây là thao tác có rủi ro cao (Mở cổng thủ công). Vui lòng nhập lý do vận hành trước khi thực thi để lưu trữ thông tin kiểm toán." 
                           Style="{StaticResource SubTitleStyle}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                <!-- Quick Selection Tags -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="CHỌN NHANH LÝ DO:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Xe VIP / Khách đặc biệt" Click="QuickReason_Click" Margin="0,0,6,6" Padding="8,4" Background="#E8EFF9" Foreground="{StaticResource APSBlueBrush}" BorderThickness="0"/>
                        <Button Content="Lỗi nhận dạng biển số" Click="QuickReason_Click" Margin="0,0,6,6" Padding="8,4" Background="#E8EFF9" Foreground="{StaticResource APSBlueBrush}" BorderThickness="0"/>
                        <Button Content="Thẻ RFID gặp sự cố" Click="QuickReason_Click" Margin="0,0,6,6" Padding="8,4" Background="#E8EFF9" Foreground="{StaticResource APSBlueBrush}" BorderThickness="0"/>
                        <Button Content="Xe khẩn cấp / Cứu hỏa" Click="QuickReason_Click" Margin="0,0,6,6" Padding="8,4" Background="#E8EFF9" Foreground="{StaticResource APSBlueBrush}" BorderThickness="0"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Input Text Box -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="NHẬP CHI TIẾT LÝ DO:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtReason" Style="{StaticResource ModernTextBox}" Height="40" FontSize="14" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="txtError" Foreground="{StaticResource APSRedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="HỦY BỎ" Style="{StaticResource ModernOutlineButton}" Width="100" Height="38" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button Content="XÁC NHẬN MỞ CỔNG" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" Width="180" Height="38" Click="BtnOk_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
