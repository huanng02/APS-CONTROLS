<Window x:Class="QuanLyGiuXe.C3200SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuanLyGiuXe.Views"
        Title="Cấu hình bộ điều khiển ZKTeco C3 Series"
        Height="660"
        Width="980"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Style to hide TabControl headers completely -->
        <Style x:Key="HeaderlessTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar ListBoxItem style -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent" 
                                BorderThickness="4,0,0,0" 
                                CornerRadius="6"
                                Padding="5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E4FA3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#F59E0B"/> <!-- Yellow/orange indicator -->
                                <Setter Property="Foreground" Value="#1E3A8A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0.0"/>
                    <GradientStop Color="#1E293B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Menu -->
                    <RowDefinition Height="Auto"/> <!-- Status/Info -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,0,20,25">
                    <TextBlock Text="⚡ APS CONTROLS" Foreground="White" FontSize="18" FontWeight="ExtraBold"/>
                    <TextBlock Text="ZKTeco C3 Series Setup" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu -->
                <ListBox x:Name="SidebarMenu" Grid.Row="1" SelectedIndex="0" 
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <StackPanel Margin="15,10">
                            <TextBlock Text="🔌 1. KẾT NỐI PHẦN CỨNG" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="IP, Cổng &amp; Nhận diện thiết bị" FontSize="10" Opacity="0.7" Margin="0,3,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <StackPanel Margin="15,10">
                            <TextBlock Text="🏢 2. VỊ TRÍ TOPOLOGY" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Chọn Site, Cổng &amp; Thiết bị" FontSize="10" Opacity="0.7" Margin="0,3,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <StackPanel Margin="15,10">
                            <TextBlock Text="📡 3. PHÂN LÀN &amp; ĐIỀU KHIỂN" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Gán đầu đọc &amp; Điều khiển làn" FontSize="10" Opacity="0.7" Margin="0,3,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <StackPanel Margin="15,10">
                            <TextBlock Text="⚙️ 4. NÚT NHẤN MỞ CỔNG" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Cài đặt nút nhấn vật lý" FontSize="10" Opacity="0.7" Margin="0,3,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Status badge -->
                <StackPanel Grid.Row="2" Margin="20,10,20,0" Orientation="Horizontal">
                    <Border Background="#10B981" CornerRadius="5" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Hệ thống sẵn sàng" Foreground="#A7F3D0" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT PANEL -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="25">
            <TabControl x:Name="MainTabControl" Style="{StaticResource HeaderlessTabControl}"
                        SelectedIndex="{Binding SelectedIndex, ElementName=SidebarMenu}">
                
                <!-- TAB 1: HARDWARE CONNECTION -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Connection Parameters -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🔌 THÔNG SỐ KẾT NỐI" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- IP Address -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="Địa chỉ IP (IP Address)" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="IpBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                                        <TextBlock Text="Ví dụ: 192.168.1.201" Foreground="#9CA3AF" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- TCP Port -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock Text="Cổng TCP (TCP Port)" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PortBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                                        <TextBlock Text="Mặc định: 4370" Foreground="#9CA3AF" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Password -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="Mật khẩu kết nối" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PwdBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                                        <TextBlock Text="Mặc định: Để trống" Foreground="#9CA3AF" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Timeout -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock Text="Timeout (ms)" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TimeoutBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                                        <TextBlock Text="Mặc định: 3000 ms" Foreground="#9CA3AF" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Barrier Pulse -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="Độ trễ Relay (Barrier)" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="BarrierBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                                        <TextBlock Text="Thời gian mở barrier (giây)" Foreground="#9CA3AF" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Cooldown -->
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock Text="Độ trễ quẹt thẻ lại" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CooldownBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                                        <TextBlock Text="Thời gian chờ chống trùng (ms)" Foreground="#9CA3AF" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Actions & Hardware Detection Summary -->
                        <StackPanel Grid.Column="2">
                            <!-- Diagnostic Actions -->
                            <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.02"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🛠️ KIỂM TRA KẾT NỐI" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>
                                    <Button Content="⚡ Test kết nối &amp; Nhận diện" Style="{StaticResource ModernButton}" Height="38" Margin="0,0,0,8" Click="TestConnection_Click"/>
                                    <Button Content="📋 Xuất log chẩn đoán chi tiết" Style="{StaticResource ModernOutlineButton}" Height="35" Click="TestConnectionDetailed_Click"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Hardware summary card -->
                            <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.02"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🛡️ THÔNG SỐ PHẦN CỨNG" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,4,0"/>
                                    <TextBlock Text="Hệ thống tự động đồng bộ khi kết nối hoặc lưu" Foreground="#718096" FontSize="10" Margin="0,2,0,12"/>
                                    
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="DÒNG TỦ CHỌN" Foreground="#4B5563" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ControllerTypeCombo" Height="36" SelectionChanged="ControllerTypeCombo_SelectionChanged" SelectedIndex="0" IsEnabled="False" Style="{StaticResource ModernComboBox}">
                                            <ComboBoxItem Content="C3-200 (2 Relay)" Tag="C3200"/>
                                            <ComboBoxItem Content="C3-400 (4 Relay)" Tag="C3400"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <UniformGrid Columns="3" Rows="1">
                                        <!-- stat 1: readers -->
                                        <Border Background="#EFF6FF" CornerRadius="8" Padding="8" Margin="0,0,4,0" BorderBrush="#BFDBFE" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="ĐẦU ĐỌC" Foreground="#1E40AF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="ReaderCountText" Text="4" Foreground="#1D4ED8" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- stat 2: relays -->
                                        <Border Background="#FFF7ED" CornerRadius="8" Padding="8" Margin="2,0,2,0" BorderBrush="#FED7AA" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="RƠ-LE" Foreground="#C2410C" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="RelayCountText" Text="2" Foreground="#EA580C" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- stat 3: max lanes -->
                                        <Border Background="#F0FDF4" CornerRadius="8" Padding="8" Margin="4,0,0,0" BorderBrush="#BBF7D0" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="LÀN TỐI ĐA" Foreground="#15803D" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="MaxLanesText" Text="2" Foreground="#16A34A" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- TAB 2: TOPOLOGY CONFIGURATION -->
                <TabItem>
                    <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.03"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🏢 ĐỊNH VỊ TOPOLOGY HỆ THỐNG" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                            <TextBlock Text="Cấu hình vị trí lắp đặt của controller trong hệ thống bãi xe." Foreground="#6B7280" FontSize="12" Margin="0,0,0,20"/>
                            
                            <!-- Step 1: Site -->
                            <Border Background="#F9FAFB" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#EFF6FF" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="1" Foreground="#1D4ED8" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Bãi xe / Chi nhánh (Site)" FontSize="13" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="SiteCombo" Style="{StaticResource ModernComboBox}" Height="36" SelectionChanged="SiteCombo_SelectionChanged"/>
                                        <TextBlock Text="Chọn phân vùng bãi đỗ xe cần cấu hình" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Step 2: Gate -->
                            <Border Background="#F9FAFB" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FEE2E2" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="2" Foreground="#DC2626" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Cổng kiểm soát (Gate)" FontSize="13" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="ZoneCombo" Style="{StaticResource ModernComboBox}" Height="36" SelectionChanged="ZoneCombo_SelectionChanged"/>
                                        <TextBlock Text="Chọn cổng vật lý tương ứng của bãi xe" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Step 3: Controller -->
                            <Border Background="#F9FAFB" CornerRadius="10" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#D1FAE5" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="3" Foreground="#059669" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Đăng ký Thiết bị (Controller)" FontSize="13" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="TopologyCombo" Style="{StaticResource ModernComboBox}" Height="36" SelectionChanged="TopologyCombo_SelectionChanged"/>
                                        <TextBlock Text="Chọn thiết bị điều khiển phần cứng được kết nối" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: READER ASSIGNMENT & RUNTIME CONTROL -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="📡 PHÂN LÀN &amp; ĐIỀU KHIỂN LÀN XE" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock Text="Gán đầu đọc vật lý cho các làn xe trong phần mềm và thực hiện điều khiển luồng xe khẩn cấp, bảo trì hoặc mở relay từ xa." Foreground="#6B7280" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Lane Runtime Control View -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.02"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🎮 BẢNG ĐIỀU KHIỂN HOẠT ĐỘNG (LANE RUNTIME CONTROL)" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>
                                <local:LaneRuntimeControlView/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Reader Mapping Grid -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="📡 CẤU HÌNH GÁN ĐẦU ĐỌC (READER ASSIGNMENT)" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <!-- Reader 1 -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5" Background="White">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="📡 ĐẦU ĐỌC 1 (READER 1)" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A"/>
                                                
                                            </StackPanel>
                                            <CheckBox x:Name="R1EnableCheck" Content="Bật đầu đọc" VerticalAlignment="Top" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Gán vào Làn xe:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12"/>
                                            <ComboBox x:Name="R1LaneCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}" Height="32" SelectionChanged="R1LaneCombo_SelectionChanged" DisplayMemberPath="LaneName" SelectedValuePath="Id"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Loại xe được phép:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12"/>
                                            <ComboBox x:Name="R1VehicleTypeCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}" Height="32" DisplayMemberPath="TenLoai" SelectedValuePath="Id"/>
                                        </Grid>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Chiều kiểm soát:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12"/>
                                            <ComboBox x:Name="R1DirCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}" Height="32">
                                                <ComboBoxItem Tag="IN">Chiều VÀO (Inbound)</ComboBoxItem>
                                                <ComboBoxItem Tag="OUT">Chiều RA (Outbound)</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Reader 2 -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5" Background="White">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="📡 ĐẦU ĐỌC 2 (READER 2)" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A"/>

                                            </StackPanel>
                                            <CheckBox x:Name="R2EnableCheck" Content="Bật đầu đọc" VerticalAlignment="Top" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Gán vào Làn xe:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12"/>
                                            <ComboBox x:Name="R2LaneCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}" Height="32" SelectionChanged="R2LaneCombo_SelectionChanged" DisplayMemberPath="LaneName" SelectedValuePath="Id"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Loại xe được phép:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12"/>
