<Window x:Class="QuanLyGiuXe.Views.CardInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông Tin Chi Tiết Thẻ RFID" Height="400" Width="680" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" WindowStyle="None" AllowsTransparency="True" BorderThickness="1" BorderBrush="#E2E8F0">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="8" Background="#F8FAFC">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Custom Header Bar -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8,8,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="THÔNG TIN CHI TIẾT THẺ" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="16" Cursor="Hand" Click="Close_Click" Width="30" Height="30">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#334155"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20,15,20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: RFID Card Details -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN THẺ" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <!-- Card Status Pill -->
                        <Border x:Name="brdStatus" HorizontalAlignment="Left" CornerRadius="12" Padding="10,4" Margin="0,0,0,16">
                            <TextBlock x:Name="txtTrangThai" Text="ACTIVE" FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Mã UID:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtUID" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tên thẻ:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtCardName" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Biển số:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtBienSo" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Loại vé:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtLoaiVe" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                        </Grid>

                        <Border BorderThickness="0,1,0,0" BorderBrush="#F1F5F9" Margin="0,10,0,10"/>

                        <TextBlock x:Name="txtDateInfo" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- Right Column: Owner Profile -->
                <Grid Grid.Column="2">
                    <!-- Case 1: Has Linked Employee -->
                    <Border x:Name="brdEmployeeInfo" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Padding="16" Visibility="Visible">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="CHỦ THẺ / NHÂN VIÊN" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" Background="#F1F5F9" BorderThickness="2" BorderBrush="#3B82F6" VerticalAlignment="Top">
                                    <Grid>
                                        <!-- Placeholder Image if no avatar -->
                                        <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                        <Image x:Name="imgAvatar" Width="80" Height="80" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Clip>
                                                <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Employee Details -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="txtEmpName" Text="Nguyễn Văn A" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtEmpCode" Text="Mã NV: NV001" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Công ty:" Foreground="#64748B" FontSize="12" Width="70" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpCompany" Text="Công ty APS" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="75,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Phòng ban:" Foreground="#64748B" FontSize="12" Width="70" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpDept" Text="Phòng kỹ thuật" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="75,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Chức vụ:" Foreground="#64748B" FontSize="12" Width="70" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpPos" Text="Kỹ sư phần mềm" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="75,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Điện thoại:" Foreground="#64748B" FontSize="12" Width="70" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpPhone" Text="0987654321" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="75,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Case 2: No Linked Employee (Fallback Panel) -->
                    <Border x:Name="brdNoEmployee" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Padding="16" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa Cập Nhật Thông Tin Chủ Thẻ" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                            <TextBlock Text="Thẻ RFID này chưa được liên kết với nhân viên nào." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Panel: Action Buttons -->
            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,8,8" Padding="20,0">
                <Grid>
                    <Button Content="Đóng cửa sổ" Width="110" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" Background="#64748B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#475569"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
