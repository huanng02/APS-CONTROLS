<Window x:Class="QuanLyGiuXe.Views.CardInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết thẻ" Height="320" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Padding="12" Background="White">
        <StackPanel>
            <TextBlock x:Name="txtTitle" Text="Chi tiết thẻ" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="UID:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="txtUID" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Biển số:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="txtBienSo" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Loại vé:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="txtLoaiVe" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Trạng thái:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="txtTrangThai" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <TextBlock x:Name="txtNotes" TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Đóng" Width="84" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
