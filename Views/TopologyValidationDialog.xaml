<Window x:Class="QuanLyGiuXe.Views.TopologyValidationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:QuanLyGiuXe.Views"
        Title="Kiểm tra tính hợp lệ của sơ đồ" Height="500" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource TopoPageBgBrush}"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="DialogIssueCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TopoCardBgBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.04" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Warning Banner -->
            <RowDefinition Height="*"/>    <!-- Scrollable issues -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="#FFF1F0" BorderBrush="{StaticResource TopoDangerBrush}" BorderThickness="1" CornerRadius="6" Padding="15,12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                      Fill="{StaticResource TopoDangerBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CẦN XỬ LÝ TRƯỚC KHI VẬN HÀNH" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TopoDangerBrush}"/>
                    <TextBlock Text="Cấu hình sơ đồ hiện tại có lỗi cần được khắc phục trước khi đưa hệ thống vào vận hành." FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Issues List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15">
            <StackPanel>
                <!-- ERRORS -->
                <StackPanel Margin="0,0,0,15">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Errors.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="LỖI CẤU HÌNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoDangerBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DialogIssueCardStyle}" BorderBrush="{StaticResource TopoDangerBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                                              Fill="{StaticResource TopoDangerBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,3,0,4" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="Đối tượng: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="Loại: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="{Binding TranslatedEntityType}" FontWeight="SemiBold"/>
                                                <Run Text="  •  Tên: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="{Binding EntityName}" FontWeight="SemiBold"/>
                                                <Run Text="  •  Mức độ ảnh hưởng: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="{Binding Impact}" FontWeight="Bold" Foreground="{StaticResource TopoDangerBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- WARNINGS -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Warnings.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="CẢNH BÁO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoWarningBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DialogIssueCardStyle}" BorderBrush="{StaticResource TopoWarningBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" 
                                              Fill="{StaticResource TopoWarningBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TopoTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,3,0,4" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TopoTextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="Đối tượng: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="Loại: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="{Binding TranslatedEntityType}" FontWeight="SemiBold"/>
                                                <Run Text="  •  Tên: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="{Binding EntityName}" FontWeight="Bold"/>
                                                <Run Text="  •  Mức độ ảnh hưởng: " Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                <Run Text="{Binding Impact}" FontWeight="Bold" Foreground="{StaticResource TopoWarningBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Area -->
        <Border Grid.Row="2" BorderBrush="{StaticResource TopoBorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lưu ý: Bạn có thể đóng thông báo này và sửa các lỗi cấu hình sau trong trình Kiểm tra sơ đồ." FontSize="11" Foreground="{StaticResource TopoTextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                <Button Grid.Column="1" Content="Đóng" Click="Close_Click" Style="{StaticResource TopoActionButton}" Width="120" Height="36" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
