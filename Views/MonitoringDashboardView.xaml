<UserControl x:Class="QuanLyGiuXe.Views.MonitoringDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyGiuXe.Views"
             xmlns:viewmodels="clr-namespace:QuanLyGiuXe.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280"
             Background="{StaticResource BgLightBrush}" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StringArrayConverter x:Key="StringArrayConverter"/>
        
        <!-- Pulsating Green Dot for Online, Static Red Dot for Offline -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Fill" Value="#10B981"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" From="1.0" To="0.4" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Fill" Value="#EF4444"/>
                    <Setter Property="Opacity" Value="1.0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status Dot Style for string states (Online/Offline) -->
        <Style x:Key="StringStateDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Online">
                    <Setter Property="Fill" Value="#10B981"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Offline">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dynamic color for sub-device indicator text -->
        <Style x:Key="SubDeviceStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="Online">
                    <Setter Property="Foreground" Value="#10B981"/>
                </Trigger>
                <Trigger Property="Text" Value="Offline">
                    <Setter Property="Foreground" Value="#EF4444"/>
                </Trigger>
                <Trigger Property="Text" Value="N/A">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Lane overall health indicator styles -->
        <Style x:Key="LaneHealthBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Healthy">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Degraded">
                    <Setter Property="Background" Value="#FFFBEB"/>
                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Critical">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#FCA5A5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Unknown">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LaneHealthBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Healthy">
                    <Setter Property="Foreground" Value="#047857"/>
                    <Setter Property="Text" Value="HEALTHY ✓"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Degraded">
                    <Setter Property="Foreground" Value="#B45309"/>
                    <Setter Property="Text" Value="DEGRADED ⚠"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Critical">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                    <Setter Property="Text" Value="CRITICAL 🚨"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallHealth}" Value="Unknown">
                    <Setter Property="Foreground" Value="#4B5563"/>
                    <Setter Property="Text" Value="UNKNOWN"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Interactive Card Button Style -->
        <Style x:Key="InteractiveCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Modern Toggle Button Style -->
        <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource APSBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource APSBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="ON"/>
                    <Setter Property="Background" Value="#10B981"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#10B981"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Content" Value="OFF"/>
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Infrastructure Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Row 2: Columns Monitor & Events -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="10,0,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left side: Title & Sync info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,15,0">
                    <TextBlock Text="🖥️" FontSize="22" Foreground="White" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ĐIỀU HÀNH &amp; GIÁM SÁT THIẾT BỊ HẠ TẦNG" FontSize="18" FontWeight="ExtraBold" Foreground="#1E293B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Cập nhật lần cuối: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding LastUpdatedTime}" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                    </StackPanel>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="25,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource APSBlueBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Right side: Refresh control -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tự động làm mới:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,10,0"/>
                    <ToggleButton IsChecked="{Binding IsAutoRefreshEnabled}" Style="{StaticResource ModernToggleButtonStyle}" Width="70" Height="28" Margin="0,0,10,0"/>

                    <TextBlock Text="Chu kỳ:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,8,0"/>
                    <ComboBox Width="70" Height="28" Style="{StaticResource ModernComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding RefreshIntervalSeconds}">
                        <ComboBoxItem Content="5s" Tag="5"/>
                        <ComboBoxItem Content="10s" Tag="10"/>
                        <ComboBoxItem Content="30s" Tag="30"/>
                        <ComboBoxItem Content="60s" Tag="60"/>
                    </ComboBox>

                    <Button Command="{Binding RefreshCommand}" Margin="12,0,5,0" Style="{StaticResource ModernButton}" Background="{StaticResource APSBlueBrush}" Width="36" Height="28" ToolTip="Làm mới ngay lập tức">
                        <TextBlock Text="🔄" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 1: Infrastructure Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="5,0,5,15">
            <!-- 1. Controllers Summary -->
            <Border Style="{StaticResource EnterpriseCardBorder}" Margin="5" Padding="12" BorderBrush="#10B981" BorderThickness="0,3,0,0">
                <StackPanel>
                    <TextBlock Text="BỘ ĐIỀU KHIỂN C3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="{Binding Summary.OnlineControllers}" FontSize="22" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text=" / " FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.TotalControllers}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding Summary.ControllerHealth, Mode=OneWay}" Height="4" Foreground="#10B981" Background="#E5E7EB" BorderThickness="0" VerticalAlignment="Center" Maximum="100"/>
                        <TextBlock Grid.Column="1" Text="{Binding Summary.ControllerHealth, StringFormat={}{0:0}%}" FontSize="9" FontWeight="Bold" Foreground="#10B981" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. RFID Readers Summary -->
            <Border Style="{StaticResource EnterpriseCardBorder}" Margin="5" Padding="12" BorderBrush="#8B5CF6" BorderThickness="0,3,0,0">
                <StackPanel>
                    <TextBlock Text="ĐẦU ĐỌC THẺ RFID" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="{Binding Summary.OnlineReaders}" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6"/>
                        <TextBlock Text=" / " FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.TotalReaders}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding Summary.ReaderHealth, Mode=OneWay}" Height="4" Foreground="#8B5CF6" Background="#E5E7EB" BorderThickness="0" VerticalAlignment="Center" Maximum="100"/>
                        <TextBlock Grid.Column="1" Text="{Binding Summary.ReaderHealth, StringFormat={}{0:0}%}" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Cameras Summary -->
            <Border Style="{StaticResource EnterpriseCardBorder}" Margin="5" Padding="12" BorderBrush="#3B82F6" BorderThickness="0,3,0,0">
                <StackPanel>
                    <TextBlock Text="CAMERA GIÁM SÁT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="{Binding Summary.OnlineCameras}" FontSize="22" FontWeight="Bold" Foreground="#3B82F6"/>
                        <TextBlock Text=" / " FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.TotalCameras}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding Summary.CameraHealth, Mode=OneWay}" Height="4" Foreground="#3B82F6" Background="#E5E7EB" BorderThickness="0" VerticalAlignment="Center" Maximum="100"/>
                        <TextBlock Grid.Column="1" Text="{Binding Summary.CameraHealth, StringFormat={}{0:0}%}" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Lanes Summary -->
            <Border Style="{StaticResource EnterpriseCardBorder}" Margin="5" Padding="12" BorderBrush="#06B6D4" BorderThickness="0,3,0,0">
                <StackPanel>
                    <TextBlock Text="LÀN XE VẬN HÀNH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="{Binding Summary.OnlineLanes}" FontSize="22" FontWeight="Bold" Foreground="#06B6D4"/>
                        <TextBlock Text=" / " FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.TotalLanes}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding Summary.LaneHealth, Mode=OneWay}" Height="4" Foreground="#06B6D4" Background="#E5E7EB" BorderThickness="0" VerticalAlignment="Center" Maximum="100"/>
                        <TextBlock Grid.Column="1" Text="{Binding Summary.LaneHealth, StringFormat={}{0:0}%}" FontSize="9" FontWeight="Bold" Foreground="#06B6D4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Row 2: Columns Monitor & Events -->
        <Grid Grid.Row="2" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/> <!-- Col 0: Lanes Monitor -->
                <ColumnDefinition Width="1.1*"/> <!-- Col 1: Devices Monitor -->
                <ColumnDefinition Width="1*"/>   <!-- Col 2: Real-time Event Logs -->
            </Grid.ColumnDefinitions>

            <!-- Col 0: Lanes Monitor -->
            <Border Grid.Column="0" Style="{StaticResource EnterpriseCardBorder}" Margin="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="GIÁM SÁT LÀN XE" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Sẵn sàng: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OnlineLanesCount}" FontWeight="Bold" Foreground="#10B981" FontSize="11"/>
                            <TextBlock Text="/" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalLanesCount}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LanesStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="White" CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Lane Code & Name & Status Badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LaneCode}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding LaneName}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource LaneHealthBadgeStyle}" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource LaneHealthBadgeTextStyle}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Lane Info Direction & Zone -->
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="Hướng: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Border CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Direction}" Value="IN">
                                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Direction}" Value="OUT">
                                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Direction}" Value="IN">
                                                                            <Setter Property="Text" Value="VÀO"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource APSBlueBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Direction}" Value="OUT">
                                                                            <Setter Property="Text" Value="RA"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource APSRedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="Khu: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ZoneName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Sub-devices statuses grid -->
                                            <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="🎛️ Tủ C3: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ControllerStatus}" Style="{StaticResource SubDeviceStatusTextStyle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="💳 Đầu đọc: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ReaderStatus}" Style="{StaticResource SubDeviceStatusTextStyle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="📷 Camera: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding CameraStatus}" Style="{StaticResource SubDeviceStatusTextStyle}"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <!-- Status Message Details -->
                                            <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,6" CornerRadius="4" Background="#F9FAFB">
                                                <TextBlock Text="{Binding StatusDetails}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Col 1: Devices Monitor (Controllers, Readers, Cameras) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="5,5,5,5">
                <StackPanel>
                    <!-- 1. Controllers Panel -->
                    <Border Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,15" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="BỘ ĐIỀU KHIỂN C3" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OnlineControllersCount, StringFormat={}Online: {0}}" FontSize="10" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <ItemsControl ItemsSource="{Binding C3ControllersStatus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource InteractiveCardButtonStyle}" Command="{Binding DataContext.ShowDeviceDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource StringArrayConverter}">
                                                    <Binding Source="Controller"/>
                                                    <Binding Path="ControllerName"/>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ControllerName}" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding IpAddress, StringFormat={}🌐 IP: {0}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding GateName, StringFormat={}📍 Cổng: {0}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding StatusDetails}" FontSize="10" Foreground="#6B7280" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Ellipse Style="{StaticResource StatusDotStyle}"/>
                                                    <TextBlock Text="{Binding PingLatencyMs, StringFormat={}{0} ms}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,3,0,0"
                                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>



                    <!-- 3. Cameras Panel -->
                    <Border Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,15" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="CAMERA GIÁM SÁT" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OnlineCamerasCount, StringFormat={}Online: {0}}" FontSize="10" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <ItemsControl ItemsSource="{Binding CamerasStatus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource InteractiveCardButtonStyle}" Command="{Binding DataContext.ShowDeviceDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource StringArrayConverter}">
                                                    <Binding Source="Camera"/>
                                                    <Binding Path="CameraName"/>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding CameraName}" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding IpAddress, StringFormat={}🌐 IP: {0}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding LaneName, StringFormat={}📍 Làn: {0}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding StatusDetails}" FontSize="10" Foreground="#6B7280" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Ellipse Style="{StaticResource StringStateDotStyle}"/>
                                                    <TextBlock Text="TRỰC TIẾP" FontSize="9" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" Margin="0,3,0,0"
                                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 4. RFID Readers Panel -->
                    <Border Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,10" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="ĐẦU ĐỌC THẺ RFID" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OnlineReadersCount, StringFormat={}Online: {0}}" FontSize="10" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <ItemsControl ItemsSource="{Binding RfidReadersStatus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource InteractiveCardButtonStyle}" Command="{Binding DataContext.ShowDeviceDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource StringArrayConverter}">
                                                    <Binding Source="Reader"/>
                                                    <Binding Path="ReaderName"/>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ReaderName}" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding ConnectionType, StringFormat={}🔌 Loại: {0}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding AssociatedLaneName, StringFormat={}📍 Làn: {0}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding StatusDetails}" FontSize="10" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Ellipse Grid.Column="1" Style="{StaticResource StatusDotStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Col 2: Real-time Event Logs -->
            <Border Grid.Column="2" Style="{StaticResource EnterpriseCardBorder}" Margin="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="NHẬT KÝ THIẾT BỊ HỆ THỐNG" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock Text="Truyền phát trực tiếp" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DeviceEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                        <Setter Property="BorderBrush" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                        <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Background" Value="#FFF1F2"/>
                                                        <Setter Property="BorderBrush" Value="#FECDD3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                        <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontFamily="Consolas" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="#9F1239"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                                    <Setter Property="Foreground" Value="#047857"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="11" FontWeight="Bold" Foreground="#374151" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                
                                                <Border Grid.Column="2" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Background" Value="#FDE68A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Background" Value="#FCA5A5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Background" Value="#FECDD3"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                                    <Setter Property="Background" Value="#A7F3D0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DeviceType}" FontSize="8" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                        <Setter Property="Foreground" Value="#881337"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="#4B5563" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- DEVICE DETAIL DIAGNOSTICS POPUP OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#800F172A" Visibility="{Binding IsDeviceDetailVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="450" Height="500" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#1E293B" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & close -->
                        <RowDefinition Height="Auto"/> <!-- Info Grid -->
                        <RowDefinition Height="*"/>    <!-- Event Feed Specific -->
                        <RowDefinition Height="Auto"/> <!-- Close Button -->
                    </Grid.RowDefinitions>

                    <!-- Title & close -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CHI TIẾT CHẨN ĐOÁN THIẾT BỊ" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ModernButton}" Command="{Binding CloseDeviceDetailCommand}" Background="Transparent" Width="30" Height="30" HorizontalAlignment="Right">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#6B7280"/>
                        </Button>
                    </Grid>

                    <!-- Info Grid -->
                    <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Labels -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên thiết bị:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,15,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Loại thiết bị:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,15,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Địa chỉ IP / Cổng:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,15,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Phiên bản Firmware:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,15,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Trạng thái hiện tại:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,15,3"/>

                            <!-- Values -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDeviceDetail.DeviceName}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDeviceDetail.DeviceType}" FontSize="12" Foreground="#4B5563" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDeviceDetail.IpAddress}" FontSize="12" FontFamily="Consolas" Foreground="#4B5563" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDeviceDetail.FirmwareVersion}" FontSize="12" Foreground="#4B5563" Margin="0,3,0,3"/>
                            
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDeviceDetail.IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedDeviceDetail.IsOnline}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SelectedDeviceDetail.CurrentStatus}" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDeviceDetail.IsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedDeviceDetail.IsOnline}" Value="False">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedDeviceDetail.StatusDetails, StringFormat={} ({0})}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Event Feed Specific -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LỊCH SỬ SỰ KIỆN GẦN ĐÂY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedDeviceDetail.RecentEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="8" CornerRadius="4" Background="#F9FAFB" BorderBrush="#F3F4F6" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontFamily="Consolas" FontSize="10" Foreground="#4B5563" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="10.5" Foreground="#1F2937" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Close Button -->
                    <Button Grid.Row="3" Content="ĐÓNG" Style="{StaticResource ModernButton}" Command="{Binding CloseDeviceDetailCommand}" Background="#1E293B" Width="120" Height="32" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
