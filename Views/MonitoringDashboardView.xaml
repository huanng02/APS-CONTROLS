<UserControl x:Class="QuanLyGiuXe.Views.MonitoringDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyGiuXe.Views"
             xmlns:viewmodels="clr-namespace:QuanLyGiuXe.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280"
             Background="{StaticResource BgLightBrush}" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Pulsating Green Dot for Online, Static Red Dot for Offline -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Fill" Value="#2ECC71"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" From="1.0" To="0.3" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Fill" Value="#E74C3C"/>
                    <Setter Property="Opacity" Value="1.0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status Badge Border Style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Background" Value="#E8F8F5"/>
                    <Setter Property="BorderBrush" Value="#A3E4D7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Background" Value="#FDEDEC"/>
                    <Setter Property="BorderBrush" Value="#FADBD8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status Badge Text Style -->
        <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Foreground" Value="#117A65"/>
                    <Setter Property="Text" Value="ONLINE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Foreground" Value="#922B21"/>
                    <Setter Property="Text" Value="OFFLINE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Modern Toggle Button Style -->
        <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource APSBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource APSBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="ON"/>
                    <Setter Property="Background" Value="#2ECC71"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Content" Value="OFF"/>
                    <Setter Property="Background" Value="#E74C3C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#E74C3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / Control Room Header -->
            <RowDefinition Height="Auto"/> <!-- Operational KPI Cards -->
            <RowDefinition Height="*"/>    <!-- Realtime Monitor Panels (Lanes, C3, RFID) -->
        </Grid.RowDefinitions>

        <!-- Control Room Header -->
        <Grid Grid.Row="0" Margin="10,0,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left side: Title & Sync info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2C3E50" CornerRadius="6" Padding="12,10" Margin="0,0,15,0">
                    <TextBlock Text="🖥️" FontSize="22" Foreground="White" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MONITORING &amp; OPERATION CONTROL ROOM" FontSize="18" FontWeight="ExtraBold" Foreground="#2C3E50"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Cập nhật lần cuối: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding LastUpdatedTime}" FontSize="12" FontWeight="Bold" Foreground="#2C3E50"/>
                    </StackPanel>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="25,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource APSBlueBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Right side: Refresh control dashboard -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tự động làm mới:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,10,0"/>
                    <ToggleButton IsChecked="{Binding IsAutoRefreshEnabled}" Style="{StaticResource ModernToggleButtonStyle}" Width="80" Height="30" Margin="0,0,10,0"/>

                    <TextBlock Text="Chu kỳ:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,8,0"/>
                    <ComboBox Width="80" Height="30" Style="{StaticResource ModernComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding RefreshIntervalSeconds}">
                        <ComboBoxItem Content="5s" Tag="5"/>
                        <ComboBoxItem Content="10s" Tag="10"/>
                        <ComboBoxItem Content="30s" Tag="30"/>
                    </ComboBox>

                    <Button Command="{Binding RefreshCommand}" Margin="15,0,5,0" Style="{StaticResource ModernButton}" Background="{StaticResource APSBlueBrush}" Width="40" ToolTip="Làm mới ngay lập tức">
                        <TextBlock Text="🔄" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Operational KPI Cards -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="10,0,10,15">
            <!-- Vehicles In Today -->
            <Border Style="{StaticResource EnterpriseCardBorder}" Padding="15,12" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LƯỢT XE VÀO HÔM NAY" Style="{StaticResource SubTitleStyle}"/>
                        <TextBlock Text="{Binding LuotXeVaoHomNay}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                        <TextBlock Text="Đang tăng liên tục" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="📥" FontSize="36" Opacity="0.25" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Vehicles Out Today -->
            <Border Style="{StaticResource EnterpriseCardBorder}" Padding="15,12" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LƯỢT XE RA HÔM NAY" Style="{StaticResource SubTitleStyle}"/>
                        <TextBlock Text="{Binding LuotXeRaHomNay}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                        <TextBlock Text="Đã thanh toán đầy đủ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="📤" FontSize="36" Opacity="0.25" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Realtime Monitor Panels -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/> <!-- Lanes Monitor -->
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="0.9*"/> <!-- C3 Controllers Monitor -->
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="0.9*"/> <!-- RFID Readers Monitor -->
            </Grid.ColumnDefinitions>

            <!-- Left: Lanes Monitor -->
            <Border Grid.Column="0" Style="{StaticResource EnterpriseCardBorder}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="LÀN XE VẬN HÀNH (LANES)" Style="{StaticResource Heading2Style}" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Online: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OnlineLanesCount}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                            <TextBlock Text="/" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalLanesCount}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LanesStatus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="White" CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#D4EFDF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#FADBD8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Lane Code & Name & Status Badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Border Background="#EBF5FB" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LaneCode}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding LaneName}" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Lane Topology info -->
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="Chiều: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Border CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Direction}" Value="IN">
                                                                        <Setter Property="Background" Value="#EBF5FB"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Direction}" Value="OUT">
                                                                        <Setter Property="Background" Value="#FFF5F5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Direction}" Value="IN">
                                                                            <Setter Property="Text" Value="VÀO (IN)"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource APSBlueBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Direction}" Value="OUT">
                                                                            <Setter Property="Text" Value="RA (OUT)"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource APSRedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="Khu: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ZoneName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Camera info -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="📷 Camera: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding AssociatedCamera}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Status Message Details -->
                                            <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,6" CornerRadius="4" Background="#F8F9FA">
                                                <TextBlock Text="{Binding StatusDetails}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Middle: C3 Controllers Monitor -->
            <Border Grid.Column="2" Style="{StaticResource EnterpriseCardBorder}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="BỘ ĐIỀU KHIỂN C3 (CONTROLLERS)" Style="{StaticResource Heading2Style}" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Online: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OnlineControllersCount}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                            <TextBlock Text="/" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalControllersCount}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding C3ControllersStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding ControllerName}" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="🌐 IP: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding IpAddress}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="📍 Cổng: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding GateName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusDetails}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Status Dot & Latency badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border Style="{StaticResource StatusBadgeStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource StatusDotStyle}"/>
                                                        <TextBlock Style="{StaticResource StatusBadgeTextStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <!-- Latency badge (only if online and latency valid) -->
                                                <Border Background="#F2F3F4" CornerRadius="4" Padding="5,2" Margin="0,5,0,0" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding PingLatencyMs, StringFormat={}{0} ms}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: RFID Readers Monitor -->
            <Border Grid.Column="4" Style="{StaticResource EnterpriseCardBorder}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="ĐẦU ĐỌC THẺ RFID (READERS)" Style="{StaticResource Heading2Style}" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Online: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OnlineReadersCount}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                            <TextBlock Text="/" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalReadersCount}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RfidReadersStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding ReaderName}" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="🔌 Loại: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ConnectionType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="📍 Làn: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding AssociatedLaneName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusDetails}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Status Dot badge -->
                                            <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusDotStyle}"/>
                                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
