                                                                <TextBlock Text="Loại: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                                <TextBlock Text="{Binding TranslatedEntityType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>
                                                                <TextBlock Text="  •  Tên: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                                <TextBlock Text="{Binding EntityName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TopoTextSecondaryBrush}"/>

                                                                <TextBlock Text="  •  Mức độ ảnh hưởng: " FontSize="11" Foreground="{StaticResource TopoTextMutedBrush}"/>
                                                                <TextBlock Text="{Binding Impact}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TopoPrimaryBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- LOADING SPINNER & OVERLAY (Visible if loading) -->
                        <Border Background="#B0F5F7FA" 
                                CornerRadius="8"
                                Visibility="{Binding IsValidationLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" 
                                             Width="200" Height="6" 
                                             Background="{StaticResource TopoPrimaryLightBrush}" 
                                             Foreground="{StaticResource TopoPrimaryBrush}" 
                                             Margin="0,0,0,15"/>
                                <TextBlock Text="Đang chạy trình kiểm tra tính hợp lệ của sơ đồ bãi xe..." 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource TopoTextPrimaryBrush}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Đang phân tích các bộ điều khiển, làn xe, cổng và cấu hình ánh xạ..." 
                                           FontSize="12" 
                                           Foreground="{StaticResource TopoTextSecondaryBrush}" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
