<UserControl x:Class="QuanLyGiuXe.Views.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuanLyGiuXe.ViewModels"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:EmployeeViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search & Advanced Filter Bar -->
        <Border Grid.Row="0" Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,16" Padding="15,10">
            <StackPanel>
                <!-- Row 1: Search -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}" FontSize="16"/>
                        <TextBox x:Name="txtSearch" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="300" Height="36" Padding="10,0" VerticalContentAlignment="Center"/>
                        
                        <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="20,0,8,0" Style="{StaticResource SubTitleStyle}"/>
                        <ComboBox SelectedValue="{Binding StatusFilter, Mode=TwoWay}" SelectedValuePath="Content" Style="{StaticResource ModernComboBox}" Width="110" Height="36">
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="Hoạt động"/>
                            <ComboBoxItem Content="Ngừng hoạt động"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Tải Template" Click="DownloadTemplate_Click" Style="{StaticResource ModernOutlineButton}" Height="36" Padding="15,0" Margin="0,0,10,0"/>
                        <Button Content="Nhập từ Excel" Click="OpenImport_Click" Style="{StaticResource ModernOutlineButton}" Height="36" Padding="15,0" Margin="0,0,10,0"/>
                        <Button Content="Thêm nhân viên" Command="{Binding AddCommand}" Style="{StaticResource ModernButton}" Height="36" Padding="15,0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Cascading Filters -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Công ty:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SubTitleStyle}"/>
                    <ComboBox ItemsSource="{Binding Companies}" 
                              SelectedItem="{Binding SelectedCompanyFilter, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBox}" Width="180" Height="32"/>

                    <TextBlock Text="Phòng ban:" VerticalAlignment="Center" Margin="15,0,8,0" Style="{StaticResource SubTitleStyle}"/>
                    <ComboBox ItemsSource="{Binding Departments}" 
                              SelectedItem="{Binding SelectedDepartmentFilter, Mode=TwoWay}"
                              DisplayMemberPath="DepartmentName"
                              Style="{StaticResource ModernComboBox}" Width="180" Height="32"/>

                    <TextBlock Text="Chức danh:" VerticalAlignment="Center" Margin="15,0,8,0" Style="{StaticResource SubTitleStyle}"/>
                    <ComboBox ItemsSource="{Binding Positions}" 
                              SelectedItem="{Binding SelectedPositionFilter, Mode=TwoWay}"
                              DisplayMemberPath="PositionName"
                              Style="{StaticResource ModernComboBox}" Width="150" Height="32"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data Grid & Pagination -->
        <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Padding="0">
            <DockPanel>
                <!-- Pagination Bar (Bottom) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgLightBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Paging Nav -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⏮" Command="{Binding FirstPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Margin="0,0,5,0" Height="32"/>
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Margin="0,0,15,0" Height="32"/>
                            
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="Trang " Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="{Binding CurrentPageDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                <Run Text=" / " Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                            </TextBlock>
                            
                            <Button Content="▶" Command="{Binding NextPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Margin="15,0,5,0" Height="32"/>
                            <Button Content="⏭" Command="{Binding LastPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Height="32"/>
                        </StackPanel>

                        <!-- Total Records -->
                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource BgLightBrush}" CornerRadius="12" Padding="12,4" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <TextBlock FontSize="12">
                                <Run Text="TỔNG CỘNG: " Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold"/>
                                <Run Text="{Binding TotalRecords, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                <Run Text=" NHÂN VIÊN" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>

                        <!-- Page Size -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hiển thị:" VerticalAlignment="Center" Style="{StaticResource SubTitleStyle}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Width="70" Style="{StaticResource ModernComboBox}" Height="32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid (Fill) -->
                <DataGrid ItemsSource="{Binding Items}" 
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGrid}"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã nhân viên" Binding="{Binding EmployeeCode}" Width="110" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="180"/>
                        <DataGridTextColumn Header="Công ty" Binding="{Binding CompanyName}" Width="150"/>
                        <DataGridTextColumn Header="Phòng ban" Binding="{Binding DepartmentName}" Width="150"/>
                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding PositionName}" Width="120"/>
                        <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="120"/>
                        
                        <DataGridTemplateColumn Header="Trạng thái" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                            <Setter Property="Foreground" Value="{StaticResource APSRedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Chi tiết" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" 
                                                Height="28" Padding="10,0" Margin="2,0" FontSize="11"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Thêm thẻ" Style="{StaticResource ModernButton}" Background="{StaticResource WarningBrush}" 
                                                Height="28" Padding="10,0" Margin="2,0" FontSize="11"
                                                Command="{Binding DataContext.AddCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Sửa" Style="{StaticResource ModernButton}" Background="{StaticResource APSBlueBrush}" 
                                                Height="28" Padding="10,0" Margin="2,0" FontSize="11"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Xóa" Style="{StaticResource DangerButton}" 
                                                Height="28" Padding="10,0" Margin="2,0" FontSize="11"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
