<Window x:Class="QuanLyGiuXe.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý người dùng" 
        Height="720" Width="1200"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgLightBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="Auto"/> <!-- Search & Filters & Action Buttons -->
            <RowDefinition Height="*"/>    <!-- Data Grid -->
        </Grid.RowDefinitions>

        <!-- Title & Subtitle Badge Header -->
        <Border Grid.Row="0" Style="{StaticResource EnterpriseCardBorder}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="👤 QUẢN LÝ NGƯỜI DÙNG" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSBlueBrush}"/>
                    <TextBlock Text="Xem danh sách, chỉnh sửa thông tin, đặt lại mật khẩu và cấu hình phân quyền người dùng" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Total Count Badge -->
                <Border Grid.Column="1" Background="{StaticResource BgLightBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="15,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TỔNG SỐ USER: " Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotalCount" Text="0" Foreground="{StaticResource APSBlueBrush}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Toolbar (Search + Filters + Action Buttons) -->
        <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,16" Padding="15,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Search & Filter controls -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}" FontSize="16"/>
                        <TextBox x:Name="TxtSearch" 
                                 Style="{StaticResource ModernTextBox}"
                                 Width="300" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 Tag="Tìm tên hoặc username..."
                                 TextChanged="TxtSearch_TextChanged"/>
                        
                        <TextBlock Text="Vai trò:" VerticalAlignment="Center" Margin="20,0,8,0" Style="{StaticResource SubTitleStyle}"/>
                        <ComboBox x:Name="CboRoleFilter" 
                                  Style="{StaticResource ModernComboBox}" 
                                  Width="180" Height="36"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="CboRoleFilter_SelectionChanged"/>

                        <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="20,0,8,0" Style="{StaticResource SubTitleStyle}"/>
                        <ComboBox x:Name="CboStatusFilter" 
                                  Style="{StaticResource ModernComboBox}" 
                                  Width="120" Height="36"
                                  SelectionChanged="CboStatusFilter_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Disabled"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="1" Content="↺ Refresh" Click="BtnRefresh_Click" Style="{StaticResource ModernOutlineButton}" Height="36" Padding="15,0"/>
                </Grid>

                <!-- Row 2: Action Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                    <Button x:Name="BtnAdd" Content="＋ Thêm" Click="BtnAdd_Click" Style="{StaticResource ModernButton}" Height="36" Padding="15,0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnEdit" Content="✏ Sửa" Click="BtnEdit_Click" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" Height="36" Padding="15,0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnDisable" Content="⊘ Disable" Click="BtnDisable_Click" Style="{StaticResource DangerButton}" Height="36" Padding="15,0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnResetPassword" Content="🔑 Reset Password" Click="BtnResetPassword_Click" Style="{StaticResource ModernOutlineButton}" Height="36" Padding="15,0" Margin="0,0,10,0"/>
                    <Border Width="1" Background="{StaticResource BorderLightBrush}" Margin="10,5" VerticalAlignment="Stretch"/>
                    <Button x:Name="BtnPermissionMatrix" Content="🛡 Ma trận quyền" Click="BtnPermissionMatrix_Click" Style="{StaticResource ModernOutlineButton}" Height="36" Padding="15,0" Margin="10,0,10,0"/>
                    <Button x:Name="BtnAuditHistory" Content="📜 Nhật ký Audit" Click="BtnAuditHistory_Click" Style="{StaticResource ModernOutlineButton}" Height="36" Padding="15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" Style="{StaticResource EnterpriseCardBorder}" Padding="0">
            <DataGrid x:Name="GridUsers" 
                      Style="{StaticResource ModernDataGrid}"
                      Margin="0"
                      MouseDoubleClick="GridUsers_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Họ &amp; Tên" Binding="{Binding Ten}" Width="*"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleName}" Width="150"/>
                    
                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Disabled">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Disabled">
                                                        <Setter Property="Foreground" Value="{StaticResource APSRedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="150"/>
                    <DataGridTextColumn Header="Đăng nhập cuối" Binding="{Binding LastLogin, StringFormat=\{0:dd/MM/yyyy HH:mm\}, TargetNullValue='—'}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
