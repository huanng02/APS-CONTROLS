<Window x:Class="QuanLyGiuXe.Views.ScanSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin lượt" Height="260" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Padding="12" Background="White">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Thông tin lượt" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="UID:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="UidText" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Biển số:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="PlateText" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Thời gian vào:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="TimeInText" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Thời gian ra:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="TimeOutText" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phí:" Grid.Column="0" Foreground="Gray"/>
                <TextBlock x:Name="FeeText" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Đóng" Width="84" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
