<Window x:Class="QuanLyGiuXe.Views.ScanSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông Tin Chi Tiết Lượt Xe" Height="400" Width="680" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" WindowStyle="None" AllowsTransparency="True" BorderThickness="1" BorderBrush="#E2E8F0">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="8" Background="#F8FAFC">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Custom Header Bar -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8,8,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="CHI TIẾT LƯỢT XE" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="16" Cursor="Hand" Click="Close_Click" Width="30" Height="30">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#334155"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20,15,20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Session details -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN LƯỢT" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Mã thẻ UID:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UidText" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Biển số xe:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PlateText" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="#2563EB"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Thời gian vào:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimeInText" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Thời gian ra:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimeOutText" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Phí gửi xe:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeeText" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="#16A34A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Separator line 1 -->
                <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="4,0"/>

                <!-- Middle Column: Owner Profile -->
                <Grid Grid.Column="2">
                    <!-- Case 1: Has Linked Employee -->
                    <Border x:Name="brdEmployeeInfo" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Padding="12" Visibility="Visible">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="CHỦ THẺ / NHÂN VIÊN" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="70" Height="70" CornerRadius="35" Background="#F1F5F9" BorderThickness="2" BorderBrush="#3B82F6" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="👤" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                        <Image x:Name="imgAvatar" Width="70" Height="70" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Clip>
                                                <EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Employee Details -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="txtEmpName" Text="Nguyễn Văn A" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="txtEmpCode" Text="Mã NV: NV001" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Công ty:" Foreground="#64748B" FontSize="11" Width="55" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpCompany" Text="Công ty APS" Foreground="#334155" FontSize="11" FontWeight="SemiBold" Margin="60,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Phòng ban:" Foreground="#64748B" FontSize="11" Width="55" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpDept" Text="Phòng kỹ thuật" Foreground="#334155" FontSize="11" FontWeight="SemiBold" Margin="60,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Chức vụ:" Foreground="#64748B" FontSize="11" Width="55" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpPos" Text="Kỹ sư phần mềm" Foreground="#334155" FontSize="11" FontWeight="SemiBold" Margin="60,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Điện thoại:" Foreground="#64748B" FontSize="11" Width="55" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="txtEmpPhone" Text="0987654321" Foreground="#334155" FontSize="11" FontWeight="SemiBold" Margin="60,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Case 2: No Linked Employee (Fallback Panel) -->
                    <Border x:Name="brdNoEmployee" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Padding="16" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa liên kết chủ thẻ" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                            <TextBlock Text="Thẻ RFID này chưa được liên kết với nhân viên nào." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Separator line 2 -->
                <Border Grid.Column="3" Width="1" Background="#E2E8F0" Margin="4,0"/>

                <!-- Right-most Column: Plate Comparison -->
                <StackPanel Grid.Column="4" VerticalAlignment="Top" Margin="5,0,0,0">
                    <TextBlock Text="SO SÁNH BIỂN SỐ" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    
                    <!-- Entry Plate -->
                    <StackPanel x:Name="EntryPlatePanel" Margin="0,0,0,12">
                        <TextBlock Text="Biển vào:" Foreground="#2563EB" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border Background="White" CornerRadius="6" Padding="4" Height="55" BorderBrush="#E2E8F0" BorderThickness="1.5">
                            <Image x:Name="imgPlateIn" Stretch="Uniform" />
                        </Border>
                    </StackPanel>

                    <!-- Exit Plate -->
                    <StackPanel x:Name="ExitPlatePanel">
                        <TextBlock Text="Biển ra:" Foreground="#16A34A" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border Background="White" CornerRadius="6" Padding="4" Height="55" BorderBrush="#E2E8F0" BorderThickness="1.5">
                            <Image x:Name="imgPlateOut" Stretch="Uniform" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Bottom Panel: Action Buttons -->
            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,8,8" Padding="20,0">
                <Grid>
                    <Button Content="Đóng cửa sổ" Width="110" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" Background="#64748B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#475569"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
