<UserControl x:Class="QuanLyGiuXe.Views.ScanSessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="220" Width="360">
    <Border Padding="10" Background="#FF2D3748" CornerRadius="8" BorderBrush="#FF3A3F45" BorderThickness="1">
        <Grid>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Thông tin lượt" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="UID:" Grid.Column="0" Foreground="#B3FFFFFF"/>
                    <TextBlock x:Name="UidText" Grid.Column="1" FontWeight="SemiBold" Foreground="White"/>
                </Grid>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Biển số:" Grid.Column="0" Foreground="#B3FFFFFF"/>
                    <TextBlock x:Name="PlateText" Grid.Column="1" FontWeight="SemiBold" Foreground="White"/>
                </Grid>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Vào:" Grid.Column="0" Foreground="#B3FFFFFF"/>
                    <TextBlock x:Name="TimeInText" Grid.Column="1" FontWeight="SemiBold" Foreground="White"/>
                </Grid>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ra:" Grid.Column="0" Foreground="#B3FFFFFF"/>
                    <TextBlock x:Name="TimeOutText" Grid.Column="1" FontWeight="SemiBold" Foreground="White"/>
                </Grid>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Phí:" Grid.Column="0" Foreground="#B3FFFFFF"/>
                    <TextBlock x:Name="FeeText" Grid.Column="1" FontWeight="SemiBold" Foreground="White"/>
                </Grid>
            </StackPanel>

            <!-- Close button (top-right) -->
            <Button Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Padding="0" Click="CloseButton_Click" ToolTip="Đóng"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Foreground="White">
                <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
