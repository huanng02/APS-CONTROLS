<UserControl x:Class="QuanLyGiuXe.Views.ScanSessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="240" Width="580">
    <Border Padding="12" Background="#FF1E293B" CornerRadius="8" BorderBrush="#FF334155" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="TitleText" Text="Thông tin lượt" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                
                <!-- Close button -->
                <Button Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseButton_Click" ToolTip="Đóng"
                        Background="#22FFFFFF" BorderThickness="0" Foreground="White" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Main Split Panels -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Session details -->
                <StackPanel Grid.Column="0">
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="UID:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="UidText" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Biển số:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="PlateText" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thời gian vào:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="TimeInText" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thời gian ra:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="TimeOutText" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Phí gửi xe:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="FeeText" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#4ADE80" FontSize="12"/>
                    </Grid>
                </StackPanel>

                <!-- Separator line -->
                <Border Grid.Column="1" Width="1" Background="#334155" Margin="4,0"/>

                <!-- Middle Column: Card Owner (Employee) -->
                <Grid Grid.Column="2">
                    <!-- Case 1: Linked Employee -->
                    <Grid x:Name="brdEmployeeInfo" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Background="#334155" BorderThickness="1.5" BorderBrush="#3B82F6" VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <Image x:Name="imgAvatar" Width="60" Height="60" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Clip>
                                        <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Owner details -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock x:Name="txtEmpName" Text="Nguyễn Văn A" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,2"/>
                            <TextBlock x:Name="txtEmpCode" Text="NV001" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,6"/>
                            
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="Công ty:" Foreground="#94A3B8" FontSize="11" Width="60" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtEmpCompany" Text="-" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" Margin="65,0,0,0" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="Phòng ban:" Foreground="#94A3B8" FontSize="11" Width="60" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtEmpDept" Text="-" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" Margin="65,0,0,0" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="Chức vụ:" Foreground="#94A3B8" FontSize="11" Width="60" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtEmpPos" Text="-" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" Margin="65,0,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Case 2: No Linked Employee -->
                    <Grid x:Name="brdNoEmployee" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Chưa liên kết chủ thẻ" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Separator line 2 -->
                <Border Grid.Column="3" Width="1" Background="#334155" Margin="4,0"/>

                <!-- Right-most Column: Plate Comparison -->
                <StackPanel Grid.Column="4" VerticalAlignment="Top" Margin="5,0,0,0">
                    <TextBlock Text="SO SÁNH BIỂN SỐ" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    
                    <!-- Entry Plate -->
                    <StackPanel x:Name="EntryPlatePanel" Margin="0,0,0,10">
                        <TextBlock Text="Biển vào:" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,2"/>
                        <Border Background="#2A3547" CornerRadius="4" Padding="2" Height="50" BorderBrush="#334155" BorderThickness="1">
                            <Image x:Name="imgPlateIn" Stretch="Uniform" />
                        </Border>
                    </StackPanel>

                    <!-- Exit Plate -->
                    <StackPanel x:Name="ExitPlatePanel">
                        <TextBlock Text="Biển ra:" Foreground="#4ADE80" FontSize="11" Margin="0,0,0,2"/>
                        <Border Background="#2A3547" CornerRadius="4" Padding="2" Height="50" BorderBrush="#334155" BorderThickness="1">
                            <Image x:Name="imgPlateOut" Stretch="Uniform" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
