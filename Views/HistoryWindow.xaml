<Window x:Class="QuanLyGiuXe.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:converters="clr-namespace:QuanLyGiuXe.Converters"
        Title="Lịch sử xe"
        Height="850"
        Width="1550"
        Background="{StaticResource BgLightBrush}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- STATS CARDS & BREAKDOWN ROW -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Sleek Overall KPIs -->
            <Border Grid.Row="0" Style="{StaticResource EnterpriseCardBorder}" Padding="15,8" Margin="0,0,0,8" BorderBrush="{StaticResource APSBlueBrush}" BorderThickness="0,2,0,0">
                <UniformGrid Columns="4">
                    <!-- Total Visits -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🚗" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỔNG LƯỢT XE / TOTAL VISITS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TongLuotXe}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Total Revenue -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="💵" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỔNG DOANH THU / REVENUE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TongDoanhThu, StringFormat={}{0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Visits Today -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HÔM NAY / VISITS TODAY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding XeHomNay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Revenue Today -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="💰" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DOANH THU NAY / TODAY REVENUE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding DoanhThuHomNay, StringFormat={}{0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource APSRedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Collapsible Detailed Analytics -->
            <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Padding="8" Background="White">
                <Expander Header="Xem thống kê chi tiết theo loại vé &amp; loại xe / Detailed Analytics" IsExpanded="False" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Padding="4">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Ticket Type Breakdown -->
                        <Border Grid.Column="0" BorderBrush="#E3E6F0" BorderThickness="0,0,1,0" Margin="0,0,10,0" Padding="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🎫 THỐNG KÊ THEO LOẠI VÉ / TICKET STATS" FontWeight="Bold" FontSize="10" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,6"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                    <ItemsControl ItemsSource="{Binding ThongKeLoaiVe}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8F9FC" BorderThickness="1" BorderBrush="#E3E6F0" CornerRadius="4" Padding="8,4" Margin="0,2,6,2" MinWidth="115">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TenLoaiVe}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Vào: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="0" Text="{Binding SoLuotVao}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Margin="22,0,0,0"/>
                                                            <TextBlock Grid.Column="2" Text="Ra: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SoLuotRa}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="18,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0} đ}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Right: Vehicle Type Breakdown -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🚗 THỐNG KÊ THEO LOẠI XE / VEHICLE STATS" FontWeight="Bold" FontSize="10" Foreground="#7C3AED" Margin="0,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                <ItemsControl ItemsSource="{Binding ThongKeLoaiXe}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F5F3FF" BorderThickness="1" BorderBrush="#DDD6FE" CornerRadius="4" Padding="8,4" Margin="0,2,6,2" MinWidth="130">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TenLoaiXe}" FontWeight="Bold" Foreground="#5B21B6" FontSize="11"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="Lượt: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SoLuot}" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <TextBlock Text="Bãi: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding DangTrongBai}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0} đ}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <!-- FILTER PANEL -->
        <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,15" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: Biển số and Dates -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Biển số:" Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Width="150" Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" 
                               Style="{StaticResource ModernTextBox}"/>
                    
                    <TextBlock Text="Từ:" Style="{StaticResource BaseTextBlockStyle}" Margin="15,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding TuNgay}" Width="120" Margin="0,0,10,0"/>

                    <TextBlock Text="Đến:" Style="{StaticResource BaseTextBlockStyle}" Margin="5,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding DenNgay}" Width="120"/>
                </StackPanel>

                <!-- Column 1: Time filter (Hours + Minutes) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Thời gian:" Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    
                    <!-- Start Hour -->
                    <ComboBox Width="55" ItemsSource="{Binding HourList}" SelectedItem="{Binding StartHour, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <!-- Start Minute -->
                    <ComboBox Width="55" ItemsSource="{Binding MinuteList}" SelectedItem="{Binding StartMinute, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                    
                    <TextBlock Text="đến" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    
                    <!-- End Hour -->
                    <ComboBox Width="55" ItemsSource="{Binding HourList}" SelectedItem="{Binding EndHour, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <!-- End Minute -->
                    <ComboBox Width="55" ItemsSource="{Binding MinuteList}" SelectedItem="{Binding EndMinute, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>

                <!-- Column 2: Action Buttons (Right Aligned) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Đặt lại" Command="{Binding ResetFilterCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0"/>
                    <Button Content="Xuất Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLE AND DETAIL SPLIT -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="650" MinWidth="500" MaxWidth="1200"/>
                </Grid.ColumnDefinitions>
                
                <!-- Resizable Splitter -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D1D3E2" Margin="5,0" ShowsPreview="True"/>
            
            <!-- LEFT COLUMN: TABLE AND PAGING -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- TABLE -->
                <Border Grid.Row="0" Style="{StaticResource EnterpriseCardBorder}" Padding="1">
                    <DataGrid ItemsSource="{Binding DanhSachLichSu}"
                              SelectedItem="{Binding SelectedLichSu, Mode=TwoWay}"
                              Style="{StaticResource ModernDataGrid}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Plate Number" />
                                <MenuItem Header="Print Receipt" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="BIỂN SỐ / PLATE" Binding="{Binding BienSo}" Width="100" FontWeight="Bold"/>
                            <DataGridTextColumn Header="LOẠI VÉ / TICKET" Binding="{Binding LoaiVeName}" Width="90"/>
                            <DataGridTextColumn Header="LOẠI XE / VEHICLE" Binding="{Binding LoaiXeName}" Width="90"/>
                            <DataGridTextColumn Header="GIỜ VÀO / ENTRY" Binding="{Binding ThoiGianVao, StringFormat='dd/MM/yyyy HH:mm'}" Width="120"/>
                            <DataGridTextColumn Header="GIỜ RA / EXIT" Binding="{Binding ThoiGianRa, StringFormat='dd/MM/yyyy HH:mm'}" Width="120"/>
                            <DataGridTemplateColumn Header="DOANH THU" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tien, StringFormat=N0}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã ra">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Trong bãi">
                                                            <Setter Property="Background" Value="#FFF3E0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="Đã ra">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="Trong bãi">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MÃ THẺ" Binding="{Binding CardId}" Width="60"/>
                            <DataGridTextColumn Header="KHU VỰC" Binding="{Binding SiteName}" Width="80"/>
                            <DataGridTextColumn Header="VÙNG" Binding="{Binding ZoneName}" Width="80"/>
                            <DataGridTextColumn Header="LÀN VÀO" Binding="{Binding EntryLaneName}" Width="80"/>
                            <DataGridTextColumn Header="LÀN RA" Binding="{Binding ExitLaneName}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- PAGING -->
                <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Margin="0,15,0,0" Padding="15,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Số dòng:" Style="{StaticResource SubTitleStyle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox Width="80" Style="{StaticResource ModernComboBox}" SelectedItem="{Binding PageSize, Mode=TwoWay}" Margin="0,0,20,0">
                            <sys:Int32>25</sys:Int32>
                            <sys:Int32>50</sys:Int32>
                            <sys:Int32>100</sys:Int32>
                            <sys:Int32>500</sys:Int32>
                        </ComboBox>

                        <Button Content="⏮" Width="40" Command="{Binding TrangDauCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,5,0" Padding="5"/>
                        <Button Content="◀" Width="40" Command="{Binding TrangTruocCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,15,0" Padding="5"/>

                        <TextBlock Text="{Binding TrangHienTai}" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="/" Style="{StaticResource BaseTextBlockStyle}" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TongTrang}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Content="▶" Width="40" Command="{Binding TrangSauCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,5,0" Padding="5"/>
                        <Button Content="⏭" Width="40" Command="{Binding TrangCuoiCommand}" Style="{StaticResource ModernOutlineButton}" Padding="5"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- RIGHT COLUMN: DETAIL VIEW -->
            <Border Grid.Column="2" Style="{StaticResource EnterpriseCardBorder}" Margin="5,0,0,0" Padding="15">
                <Grid>
                    <!-- Content Panel (Visible when SelectedLichSu is NOT null) -->
                    <Grid x:Name="DetailContentGrid">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedLichSu}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="CHI TIẾT LƯỢT XE / VISIT DETAIL" Style="{StaticResource Heading2Style}" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <!-- License Plate Display -->
                        <Border Grid.Row="1" BorderBrush="#212529" BorderThickness="2" Background="White" CornerRadius="6" Padding="25,8" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="{Binding SelectedLichSu.BienSo}" FontSize="32" FontWeight="Bold" Foreground="#212529" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                        </Border>

                        <!-- Scrollable Photos and Text Details -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,5,0,0">
                                
                                <!-- XE VÀO SECTION -->
                                <Border Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,15" Padding="10" Background="#F8F9FC">
                                    <StackPanel>
                                        <TextBlock Text="📷 LƯỢT XE VÀO / ENTRY" FontWeight="Bold" FontSize="13" Foreground="{StaticResource APSBlueBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- Images Grid -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Toàn cảnh -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Toàn cảnh / Overview" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                                <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="4" Background="#F1F3F5" Height="220">
                                                    <Grid>
                                                        <Image Source="{Binding SelectedAnhVaoToanCanh}" Stretch="Uniform" Margin="1"/>
                                                        <Border Background="#F1F3F5" CornerRadius="3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedAnhVaoToanCanh}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedAnhVaoToanCanh}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="📷" FontSize="24" Foreground="#ADB5BD" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Không có ảnh" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Cam biển số -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ảnh biển số / Plate Cam" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                                <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="4" Background="#F1F3F5" Height="220">
                                                    <Grid>
                                                        <Image Source="{Binding SelectedAnhVaoBienSo}" Stretch="Uniform" Margin="1"/>
                                                        <Border Background="#F1F3F5" CornerRadius="3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedAnhVaoBienSo}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedAnhVaoBienSo}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="📷" FontSize="24" Foreground="#ADB5BD" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Không có ảnh" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Biển số cắt -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Biển số cắt / Cropped:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" BorderBrush="#212529" BorderThickness="1.5" Background="White" CornerRadius="3" Padding="5,2" Height="65" HorizontalAlignment="Left" MinWidth="220">
                                                <Grid>
                                                    <Image Source="{Binding SelectedAnhVaoBienSoCat}" Stretch="Uniform" Margin="1"/>
                                                    <Border Background="White">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedAnhVaoBienSoCat}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedAnhVaoBienSoCat}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="CHƯA CẮT" FontSize="13" FontWeight="Bold" Foreground="#868E96" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- XE RA SECTION -->
                                <Border Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,15" Padding="10" Background="#FFF8F8">
                                    <StackPanel>
                                        <TextBlock Text="📷 LƯỢT XE RA / EXIT" FontWeight="Bold" FontSize="13" Foreground="{StaticResource APSRedBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- Images Grid -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Toàn cảnh -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Toàn cảnh / Overview" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                                <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="4" Background="#F1F3F5" Height="220">
                                                    <Grid>
                                                        <Image Source="{Binding SelectedAnhRaToanCanh}" Stretch="Uniform" Margin="1"/>
                                                        <Border Background="#F1F3F5" CornerRadius="3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedAnhRaToanCanh}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedAnhRaToanCanh}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="📷" FontSize="24" Foreground="#ADB5BD" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Không có ảnh" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Cam biển số -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ảnh biển số / Plate Cam" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                                <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="4" Background="#F1F3F5" Height="220">
                                                    <Grid>
                                                        <Image Source="{Binding SelectedAnhRaBienSo}" Stretch="Uniform" Margin="1"/>
                                                        <Border Background="#F1F3F5" CornerRadius="3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedAnhRaBienSo}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedAnhRaBienSo}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="📷" FontSize="24" Foreground="#ADB5BD" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Không có ảnh" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Biển số cắt -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Biển số cắt / Cropped:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" BorderBrush="#212529" BorderThickness="1.5" Background="White" CornerRadius="3" Padding="5,2" Height="65" HorizontalAlignment="Left" MinWidth="220">
                                                <Grid>
                                                    <Image Source="{Binding SelectedAnhRaBienSoCat}" Stretch="Uniform" Margin="1"/>
                                                    <Border Background="White">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedAnhRaBienSoCat}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedAnhRaBienSoCat}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="CHƯA CẮT" FontSize="13" FontWeight="Bold" Foreground="#868E96" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Details Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Types -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại vé / Ticket:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedLichSu.LoaiVeName, TargetNullValue='Vé lượt'}" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Loại xe / Vehicle:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedLichSu.LoaiXeName, TargetNullValue='-'}" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="0,4,0,4"/>

                                    <!-- Trạng thái -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Trạng thái / Status:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedLichSu.TrangThai, TargetNullValue='-'}" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,4"/>

                                    <!-- Card ID -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Mã thẻ / Card ID:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedLichSu.CardId}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,4,0,4"/>

                                    <!-- Entry Info -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Giờ vào / In Time:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedLichSu.ThoiGianVao, StringFormat='dd/MM/yyyy HH:mm:ss'}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Làn vào / In Lane:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedLichSu.EntryLaneName}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,4,0,4"/>

                                    <!-- Exit Info -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Giờ ra / Out Time:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedLichSu.ThoiGianRa, StringFormat='dd/MM/yyyy HH:mm:ss', TargetNullValue='Chưa ra'}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Làn ra / Out Lane:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedLichSu.ExitLaneName, TargetNullValue='-'}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,4,0,4"/>

                                    <!-- Location -->
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Khu vực / Site:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedLichSu.SiteName, TargetNullValue='-'}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Vùng / Zone:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedLichSu.ZoneName, TargetNullValue='-'}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,4,0,4"/>

                                    <!-- Duration -->
                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Thời gian đỗ:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,4"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ThoiGianDo}" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,4"/>
                                </Grid>
                                
                                <Separator Margin="0,10"/>
                                
                                <!-- Revenue Display -->
                                <Border Background="#E8F5E9" CornerRadius="4" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="TIỀN THANH TOÁN: " Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding SelectedLichSu.Tien, StringFormat={}{0:N0} VNĐ, TargetNullValue='0'}" Style="{StaticResource Heading2Style}" Foreground="{StaticResource SuccessBrush}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Empty State Placeholder (Visible when SelectedLichSu is null) -->
                    <Grid x:Name="EmptyStateGrid" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedLichSu}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="48" Foreground="#ADB5BD" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chi tiết lượt xe ra vào" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chọn một hàng trong bảng để xem" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="thông tin chi tiết và hình ảnh xe." FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
