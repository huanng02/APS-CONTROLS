<UserControl x:Class="QuanLyGiuXe.Views.CompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuanLyGiuXe.ViewModels"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:CompanyViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="0" Style="{StaticResource EnterpriseCardBorder}" Margin="0,0,0,16" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}" FontSize="16"/>
                    <TextBox x:Name="txtSearch" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Width="300" Height="36" Padding="10,0" VerticalContentAlignment="Center"/>
                    
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="20,0,8,0" Style="{StaticResource SubTitleStyle}"/>
                    <ComboBox SelectedValue="{Binding StatusFilter, Mode=TwoWay}" SelectedValuePath="Content" Style="{StaticResource ModernComboBox}" Width="120" Height="36">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Add Company" Command="{Binding AddCommand}" Style="{StaticResource ModernButton}" Height="36" Padding="15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid & Pagination -->
        <Border Grid.Row="1" Style="{StaticResource EnterpriseCardBorder}" Padding="0">
            <DockPanel>
                <!-- Pagination Bar (Bottom) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgLightBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Paging Nav -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⏮" Command="{Binding FirstPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Margin="0,0,5,0" Height="32"/>
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Margin="0,0,15,0" Height="32"/>
                            
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="Page " Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="{Binding CurrentPageDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                <Run Text=" of " Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                            </TextBlock>
                            
                            <Button Content="▶" Command="{Binding NextPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Margin="15,0,5,0" Height="32"/>
                            <Button Content="⏭" Command="{Binding LastPageCommand}" Style="{StaticResource ModernOutlineButton}" Width="40" Height="32"/>
                        </StackPanel>

                        <!-- Total Records -->
                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource BgLightBrush}" CornerRadius="12" Padding="12,4" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <TextBlock FontSize="12">
                                <Run Text="TOTAL: " Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold"/>
                                <Run Text="{Binding TotalRecords, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource APSBlueBrush}"/>
                                <Run Text=" COMPANIES" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>

                        <!-- Page Size -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show:" VerticalAlignment="Center" Style="{StaticResource SubTitleStyle}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Width="70" Style="{StaticResource ModernComboBox}" Height="32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid (Fill) -->
                <DataGrid ItemsSource="{Binding Items}" 
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGrid}"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Company Code" Binding="{Binding Code}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Company Name" Binding="{Binding Name}" Width="250"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                        
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                            <Setter Property="Foreground" Value="{StaticResource APSRedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Detail" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" 
                                                Height="28" Padding="10,0" Margin="2,0" FontSize="11"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Edit" Style="{StaticResource ModernButton}" Background="{StaticResource APSBlueBrush}" 
                                                Height="28" Padding="10,0" Margin="2,0" FontSize="11"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Delete" Style="{StaticResource DangerButton}" 
                                                Height="28" Padding="10,0" Margin="2,0" FontSize="11"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
