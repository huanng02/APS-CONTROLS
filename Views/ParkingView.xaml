<UserControl x:Class="QuanLyGiuXe.Views.ParkingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyGiuXe.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="Transparent">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Lane1Column" Width="*"/>
            <ColumnDefinition x:Name="LaneSplitterColumn" Width="Auto"/>
            <ColumnDefinition x:Name="Lane2Column" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LANE 1 (LEFT) -->
        <Border Grid.Column="0" Style="{StaticResource EnterpriseCardBorder}" Padding="0" MaxWidth="700" Visibility="{Binding DataContext.IsLane1Visible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Lane 1 Header: Title, Reader Mapping (Left) & Site/Zone Topology (Right) -->
                <Border Background="{Binding DataContext.Lane1Color, RelativeSource={RelativeSource AncestorType=Window}}" Padding="15,8" CornerRadius="4,4,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.Lane1Title, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                            <TextBlock FontSize="10" Foreground="#E0E0E0" FontWeight="SemiBold" Margin="0,2,0,0">
                                <Run Text="{Binding DataContext.Lane1ReaderMappingIn, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                <Run Text=" " />
                                <Run Text="{Binding DataContext.Lane1ReaderMappingOut, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                <Run Text="{Binding DataContext.Lane1ReaderMappingEmpty, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DataContext.Lane1TopologyText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DataContext.Lane1CapacityText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="#E0E0E0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Camera 1 & Snap 1 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="Black" CornerRadius="4" Margin="0,0,4,0">
                            <Grid>
                                <Image x:Name="CameraVao1" Stretch="UniformToFill"/>
                                <Border Background="#80000000" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="CAM TOÀN CẢNH" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="Black" CornerRadius="4" Margin="4,0,0,0">
                            <Grid>
                                <Image Source="{Binding DataContext.AnhChupVao1, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                                <Border Background="#8027AE60" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="SNAP 1" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>


                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Camera 2 & Snap 2 -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="Black" CornerRadius="4" Margin="0,0,4,0">
                            <Grid>
                                <Image x:Name="CameraVao2" Stretch="UniformToFill"/>
                                <Border Background="#80000000" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="CAM BIỂN SỐ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="Black" CornerRadius="4" Margin="4,0,0,0">
                            <Grid>
                                <Image Source="{Binding DataContext.AnhChupVao2, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                                <Border Background="#8027AE60" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="SNAP 2" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Compact Horizontal Bottom Information Panel -->
                    <StackPanel Grid.Row="2">
                        <Border Background="{Binding DataContext.Lane1InfoBackground, RelativeSource={RelativeSource AncestorType=Window}}" 
                                BorderBrush="{Binding DataContext.Lane1InfoBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                BorderThickness="1.5" 
                                Padding="12,10" 
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="2.2*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- COLUMN 0: RFID Card Details -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock Text="THẺ RFID" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    
                                    <!-- Scanning details -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="UID:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.Lane1UID, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên thẻ:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataContext.Lane1CardName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Loại xe:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataContext.Lane1LoaiXe, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Loại vé:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2" VerticalAlignment="Center"/>
                                        <Border Grid.Row="3" Grid.Column="1" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Left" Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Tháng">
                                                            <Setter Property="Background" Value="#E0F2FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé tháng">
                                                            <Setter Property="Background" Value="#E0F2FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vãng lai">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé lượt">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Tháng">
                                                                <Setter Property="Foreground" Value="#0369A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé tháng">
                                                                <Setter Property="Foreground" Value="#0369A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vãng lai">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Lane1LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé lượt">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Manual input row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Width="100" Height="22" 
                                                 Text="{Binding DataContext.Lane1ManualInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" 
                                                 VerticalContentAlignment="Center" 
                                                 FontSize="11"/>
                                        <Button Content="Xử lý" 
                                                Command="{Binding DataContext.Lane1ManualSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Style="{StaticResource ModernButton}" 
                                                Background="{Binding DataContext.Lane1Color, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="40" Height="22" Margin="4,0,0,0" FontSize="10" Padding="0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- COLUMN 1: License Plate Details -->
                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0" Padding="12,0,10,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="BIỂN SỐ XE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        
                                        <!-- Plate Info Row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text=""   FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.Lane1BienSo, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="18" FontWeight="Bold" Foreground="{Binding DataContext.Lane1Color, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <!-- Embedded Large Plate Crop -->
                                        <Image Source="{Binding DataContext.Lane1PlateInImage, RelativeSource={RelativeSource AncestorType=Window}}" 
                                               Height="65" Width="200" Margin="0,4,0,0" HorizontalAlignment="Left" Stretch="Uniform" ToolTip="Biển số lúc vào"
                                               Visibility="{Binding DataContext.Lane1PlateInVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- COLUMN 2: Owner Info & Control -->
                                <Border Grid.Column="2" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Owner/Employee Info (Left side of Column 2) -->
                                        <Grid Grid.Column="0" Margin="0,0,10,0">
                                            <!-- Fallback state when there is no employee linked -->
                                            <TextBlock Text="{Binding DataContext.Lane1OwnerStatusText, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                       Visibility="{Binding DataContext.Lane1HasNoEmployee, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="11"/>
                                            
                                            <!-- Employee Details layout -->
                                            <Grid Visibility="{Binding DataContext.Lane1HasEmployee, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Avatar Image -->
                                                <Border Width="50" Height="50" CornerRadius="25" BorderThickness="1.5" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,10,0" VerticalAlignment="Top" ClipToBounds="True">
                                                    <Image Source="{Binding DataContext.Lane1EmployeeAvatar, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                                                </Border>
                                                
                                                <!-- Info Fields -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding DataContext.Lane1EmployeeName, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                                    
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã NV:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.Lane1EmployeeCode, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Công ty:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataContext.Lane1EmployeeCompany, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phòng:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataContext.Lane1EmployeeDepartment, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="SĐT:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataContext.Lane1EmployeePhone, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        
                                        <!-- Status, Fee & Gate Button (Right side of Column 2) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <!-- Status / Fee Row -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                                <TextBlock Visibility="{Binding DataContext.Lane1FeeVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding DataContext.Lane1Tien, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}PHÍ: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <StackPanel Visibility="{Binding DataContext.Lane1TimeVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding DataContext.Lane1ThoiGianVao, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="DimGray" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DataContext.Lane1ThoiGianTrongBai, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Action Button -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource ModernButton}" 
                                                        Background="{Binding DataContext.Lane1Color, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        Click="OpenGateIn_Click" 
                                                        IsEnabled="{Binding DataContext.CanOpenBarrier, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        Width="32" 
                                                        Height="28" 
                                                        ToolTip="Mở barrier làn vào"
                                                        HorizontalAlignment="Right">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M5,20 H19 V22 H5 Z M12,2 L19,9 H14 V17 H10 V9 H5 Z" Fill="White" Stretch="Uniform"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- LANE 1 SCAN OVERLAY NOTIFICATION -->
                <!-- Host for per-lane session UI (anchored to lane layout) -->
                <ContentControl x:Name="Lane1SessionHost"
                                Grid.Row="0" Grid.RowSpan="3"
                                Panel.ZIndex="100"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />

                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="Transparent"
                        Panel.ZIndex="99"
                        IsHitTestVisible="False"
                        Visibility="{Binding DataContext.IsLane1NotificationVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#2D3748"
                            BorderBrush="{Binding DataContext.Lane1NotificationColor, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="320">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- Circular status color indicator -->
                            <Border Width="28" Height="28"
                                    Background="{Binding DataContext.Lane1NotificationColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CornerRadius="14"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding DataContext.Lane1NotificationIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <!-- Notification message text -->
                            <TextBlock Text="{Binding DataContext.Lane1NotificationMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch" Visibility="{Binding DataContext.IsDualLaneMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- LANE 2 (RIGHT) -->
        <Border Grid.Column="2" Style="{StaticResource EnterpriseCardBorder}" Padding="0" MaxWidth="700" Visibility="{Binding DataContext.IsLane2Visible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Lane 2 Header: Title, Reader Mapping (Left) & Site/Zone Topology (Right) -->
                <Border Background="{Binding DataContext.Lane2Color, RelativeSource={RelativeSource AncestorType=Window}}" Padding="15,8" CornerRadius="4,4,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.Lane2Title, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                            <TextBlock FontSize="10" Foreground="#E0E0E0" FontWeight="SemiBold" Margin="0,2,0,0">
                                <Run Text="{Binding DataContext.Lane2ReaderMappingIn, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                <Run Text=" " />
                                <Run Text="{Binding DataContext.Lane2ReaderMappingOut, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                <Run Text="{Binding DataContext.Lane2ReaderMappingEmpty, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DataContext.Lane2TopologyText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DataContext.Lane2CapacityText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="#E0E0E0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Camera 1 & Snap 1 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="Black" CornerRadius="4" Margin="0,0,4,0">
                            <Grid>
                                <Image x:Name="CameraRa1" Stretch="UniformToFill"/>
                                <Border Background="#80000000" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="CAM TOÀN CẢNH" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="Black" CornerRadius="4" Margin="4,0,0,0">
                            <Grid>
                                <Image Source="{Binding DataContext.AnhChupRa1, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                                <Border Background="#80E74C3C" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="SNAP 1" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>


                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Camera 2 & Snap 2 -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="Black" CornerRadius="4" Margin="0,0,4,0">
                            <Grid>
                                <Image x:Name="CameraRa2" Stretch="UniformToFill"/>
                                <Border Background="#80000000" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="CAM BIỂN SỐ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="Black" CornerRadius="4" Margin="4,0,0,0">
                            <Grid>
                                <Image Source="{Binding DataContext.AnhChupRa2, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                                <Border Background="#80E74C3C" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="5,2" Margin="5">
                                    <TextBlock Text="SNAP 2" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Compact Horizontal Bottom Information Panel -->
                    <StackPanel Grid.Row="2">
                        <Border Background="{Binding DataContext.Lane2InfoBackground, RelativeSource={RelativeSource AncestorType=Window}}" 
                                BorderBrush="{Binding DataContext.Lane2InfoBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                BorderThickness="1.5" 
                                Padding="12,10" 
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="2.2*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- COLUMN 0: RFID Card Details -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock Text="THẺ RFID" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    
                                    <!-- Scanning details -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="UID:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.Lane2UID, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên thẻ:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataContext.Lane2CardName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Loại xe:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataContext.Lane2LoaiXe, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Loại vé:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,2" VerticalAlignment="Center"/>
                                        <Border Grid.Row="3" Grid.Column="1" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Left" Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Tháng">
                                                            <Setter Property="Background" Value="#E0F2FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé tháng">
                                                            <Setter Property="Background" Value="#E0F2FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vãng lai">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé lượt">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Tháng">
                                                                <Setter Property="Foreground" Value="#0369A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé tháng">
                                                                <Setter Property="Foreground" Value="#0369A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vãng lai">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Lane2LoaiVe, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vé lượt">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Manual input row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Width="100" Height="22" 
                                                 Text="{Binding DataContext.Lane2ManualInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" 
                                                 VerticalContentAlignment="Center" 
                                                 FontSize="11"/>
                                        <Button Content="Xử lý" 
                                                Command="{Binding DataContext.Lane2ManualSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Style="{StaticResource ModernButton}" 
                                                Background="{Binding DataContext.Lane2Color, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="40" Height="22" Margin="4,0,0,0" FontSize="10" Padding="0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- COLUMN 1: License Plate Details -->
                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0" Padding="12,0,10,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="BIỂN SỐ XE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        
                                        <!-- Plate Info Row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.Lane2BienSo, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="18" FontWeight="Bold" Foreground="{Binding DataContext.Lane2Color, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <!-- Embedded Large Plate Crop -->
                                        <Image Source="{Binding DataContext.Lane2PlateInImage, RelativeSource={RelativeSource AncestorType=Window}}" 
                                               Height="65" Width="200" Margin="0,4,0,0" HorizontalAlignment="Left" Stretch="Uniform" ToolTip="Biển số lúc vào"
                                               Visibility="{Binding DataContext.Lane2PlateInVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- COLUMN 2: Owner Info & Control -->
                                <Border Grid.Column="2" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Owner/Employee Info (Left side of Column 2) -->
                                        <Grid Grid.Column="0" Margin="0,0,10,0">
                                            <!-- Fallback state when there is no employee linked -->
                                            <TextBlock Text="{Binding DataContext.Lane2OwnerStatusText, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                       Visibility="{Binding DataContext.Lane2HasNoEmployee, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="11"/>
                                            
                                            <!-- Employee Details layout -->
                                            <Grid Visibility="{Binding DataContext.Lane2HasEmployee, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Avatar Image -->
                                                <Border Width="50" Height="50" CornerRadius="25" BorderThickness="1.5" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,10,0" VerticalAlignment="Top" ClipToBounds="True">
                                                    <Image Source="{Binding DataContext.Lane2EmployeeAvatar, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                                                </Border>
                                                
                                                <!-- Info Fields -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding DataContext.Lane2EmployeeName, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                                    
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã NV:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.Lane2EmployeeCode, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Công ty:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataContext.Lane2EmployeeCompany, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phòng:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataContext.Lane2EmployeeDepartment, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="SĐT:" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,1"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataContext.Lane2EmployeePhone, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        
                                        <!-- Status, Fee & Gate Button (Right side of Column 2) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <!-- Status / Fee Row -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                                <TextBlock Visibility="{Binding DataContext.Lane2FeeVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding DataContext.Lane2Tien, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}PHÍ: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <StackPanel Visibility="{Binding DataContext.Lane2TimeVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding DataContext.Lane2ThoiGianVao, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="DimGray" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DataContext.Lane2ThoiGianTrongBai, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Action Button -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource ModernButton}" 
                                                        Background="{Binding DataContext.Lane2Color, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        Click="OpenGateOut_Click" 
                                                        IsEnabled="{Binding DataContext.CanOpenBarrier, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        Width="32" 
                                                        Height="28" 
                                                        ToolTip="Mở barrier làn ra"
                                                        HorizontalAlignment="Right">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M5,20 H19 V22 H5 Z M12,2 L19,9 H14 V17 H10 V9 H5 Z" Fill="White" Stretch="Uniform"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Host for per-lane session UI (anchored to lane layout) -->
                <ContentControl x:Name="Lane2SessionHost"
                                Grid.Row="0" Grid.RowSpan="3"
                                Panel.ZIndex="100"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />

                <!-- LANE 2 SCAN OVERLAY NOTIFICATION -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="Transparent"
                        Panel.ZIndex="99"
                        IsHitTestVisible="False"
                        Visibility="{Binding DataContext.IsLane2NotificationVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#2D3748"
                            BorderBrush="{Binding DataContext.Lane2NotificationColor, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="320">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- Circular status color indicator -->
                            <Border Width="28" Height="28"
                                    Background="{Binding DataContext.Lane2NotificationColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CornerRadius="14"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding DataContext.Lane2NotificationIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <!-- Notification message text -->
                            <TextBlock Text="{Binding DataContext.Lane2NotificationMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
