<Window x:Class="LicenseTool.OfflineLicenseGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Bản Quyền Ngoại Tuyến - Offline License Generator" 
        Height="620" Width="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1D26"/>
            <Setter Property="BorderBrush" Value="#2F313E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="4" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="border" Property="Background" Value="#161720"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#252736"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00B4DB" Offset="0"/>
                        <GradientStop Color="#0083B0" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#242635">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#14151F" Offset="0"/>
                <GradientStop Color="#0F1017" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="KÍCH HOẠT OFFLINE" FontSize="11" FontWeight="Bold" Foreground="#00D2FF"/>
                    <TextBlock Text="Tạo Bản Quyền Ngoại Tuyến" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="✕" FontSize="16" Foreground="#8A8F9E" Padding="8" Click="Close_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Load Request File -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nạp thông tin từ file yêu cầu kích hoạt (.req)" VerticalAlignment="Center" FontSize="12" Foreground="#8A8F9E"/>
                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="Nạp file (.req)" Padding="12,6" Click="LoadRequest_Click" Background="#2F313E"/>
                    </Grid>

                    <Border Height="1" Background="#242635" Margin="0,0,0,16"/>

                    <!-- Customer Info -->
                    <TextBlock Text="TÊN KHÁCH HÀNG / DỰ ÁN:" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                    <TextBox x:Name="CustomerTextBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <!-- Product & Type -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="SẢN PHẨM:" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProductTextBox" Text="APS" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="LOẠI BẢN QUYỀN:" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                            <ComboBox x:Name="LicenseTypeComboBox" SelectedIndex="0" Height="30" Background="#1C1D26" Foreground="#FFFFFF" BorderBrush="#2F313E">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#1C1D26"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Commercial"/>
                                <ComboBoxItem Content="Trial"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Machine Code -->
                    <TextBlock Text="MÃ MÁY KHÁCH (MACHINE ID):" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                    <TextBox x:Name="MachineIdTextBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" ToolTip="Nhập mã hex 12 ký tự"/>

                    <!-- Hardware details summary -->
                    <TextBlock Text="THÔNG TIN PHẦN CỨNG CHI TIẾT (ĐỌC TỪ .REQ):" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                    <Border Background="#161720" CornerRadius="4" Padding="10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="CpuInfoText" Text="CPU ID: --" FontSize="11" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MoboInfoText" Text="Motherboard: --" FontSize="11" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DiskInfoText" Text="Disk Serial: --" FontSize="11" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BiosInfoText" Text="BIOS Serial: --" FontSize="11" Foreground="#8A8F9E"/>
                        </StackPanel>
                    </Border>

                    <!-- Features -->
                    <TextBlock Text="CÁC CHỨC NĂNG ĐƯỢC CẤP PHÉP (FEATURES):" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CameraCheckBox" Content="CAMERA (Kết nối Camera)" Foreground="#FFFFFF" Margin="0,0,0,6" IsChecked="True"/>
                        <CheckBox x:Name="LprCheckBox" Grid.Column="1" Content="LPR (Nhận diện biển số)" Foreground="#FFFFFF" Margin="0,0,0,6" IsChecked="True"/>
                        <CheckBox x:Name="RfidCheckBox" Grid.Row="1" Content="RFID (Đọc thẻ từ)" Foreground="#FFFFFF" IsChecked="True"/>
                        <CheckBox x:Name="ReportCheckBox" Grid.Row="1" Grid.Column="1" Content="REPORT (Báo cáo thống kê)" Foreground="#FFFFFF" IsChecked="True"/>
                    </Grid>

                    <!-- Expiration Days -->
                    <TextBlock Text="THỜI HẠN SỬ DỤNG (SỐ NGÀY):" FontSize="10" FontWeight="Bold" Foreground="#8A8F9E" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExpireDaysTextBox" Text="365" Style="{StaticResource ModernTextBox}" Width="150" HorizontalAlignment="Left"/>
                        <CheckBox x:Name="IsPermanentCheckBox" Grid.Column="1" Content="Vĩnh viễn (Không hết hạn)" Foreground="#8A8F9E" VerticalAlignment="Center" Checked="IsPermanentCheckBox_Checked" Unchecked="IsPermanentCheckBox_Unchecked"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBlock" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="#00D2FF" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Tạo &amp; Lưu Bản Quyền (.bin)" Padding="20,10" Click="GenerateLicense_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
